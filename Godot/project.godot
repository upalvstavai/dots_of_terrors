; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="dotsofteror"
run/main_scene="res://world.tscn"
; ОТДЕЛЬНАЯ СБОРКА ЛАБОРАТОРИИ. Тот же проект, но открывается не в игру, а в
; ступицу с окнами. Ключ с точкой — это подмена настройки для сборки, у которой
; в пресете стоит своя метка возможностей (custom_features="lab"). Так игра и
; лаборатория остаются ОДНИМ кодом: если лампа изменилась в игре, она изменилась
; и в лаборатории, потому что это один и тот же файл, а не две копии.
run/main_scene.lab="res://lab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
