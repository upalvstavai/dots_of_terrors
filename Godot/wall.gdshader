shader_type spatial;
render_mode cull_back, diffuse_burley;
// ТОЧКИ УЖАСА — стены. Не камень, а чёрная шевелящаяся масса.
//
// Ни одной текстуры: всё считается на месте, из мировых координат. Значит
// рисунок не повторяется плитками, не тянется на углах и одинаково подробен
// с любого расстояния — можно подойти вплотную и рассматривать.
//
// Три слоя, у каждого своя работа:
//   ФОРМА    — вершины реально выпирают, масса не плоская;
//   РЕЛЬЕФ   — наклон нормали по градиенту той же высоты, ловит свет палочки;
//   МЕЛОЧЬ   — линии, точки, пятна и телевизионный шум, видные только вблизи.
//
// Мелочь ГАСИТСЯ С РАССТОЯНИЯ, и это не экономия. Высокая частота на дальней
// стене превращается в мерцающую кашу: пиксель прыгает между соседними
// значениями, и коридор рябит. Вблизи та же частота — подробность.

uniform vec3 base_color : source_color = vec3(0.055, 0.058, 0.062);
uniform vec3 mad_color : source_color = vec3(0.06, 0.038, 0.095);
// Цвет свечения ведёт от зелёного к тёмно-фиолетовому по мере безумия. Смена
// цвета читается сразу и без шкалы: пока зелено — ты держишься.
uniform vec3 mad_spark : source_color = vec3(0.26, 0.12, 0.44);
uniform vec3 spark_color : source_color = vec3(0.34, 0.62, 0.44);
uniform float madness : hint_range(0.0, 1.0) = 0.0;
uniform float bulge = 0.30;                           // выпирание вершин, метры
uniform float relief : hint_range(0.0, 3.0) = 1.35;   // сила поддельного рельефа
uniform float buzz : hint_range(0.0, 2.0) = 1.0;      // телевизионный шум
uniform float near_dist = 3.2;                        // дальше этого мелочи нет совсем
// 1 — вся мелочь, 0 — только форма и рельеф. Гасит три самых дорогих слоя:
// линии в три октавы, крапины по сетке и телевизионный шум.
uniform float detail : hint_range(0.0, 1.0) = 1.0;
// ЗЕРНО ОТДЕЛЬНОЙ РУЧКОЙ. Две октавы шума на каждый пиксель стены — это
// примерно десятая часть кадра; на моей машине запас есть, на слабой его может
// не быть. Ноль здесь не «умножить на ноль», а НЕ СЧИТАТЬ: ветка ниже
// пропускает обе октавы целиком.
uniform float grain_k : hint_range(0.0, 1.0) = 1.0;

// Дешевле синуса и без его полос на больших координатах.
float hash(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
		mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y),
		f.z);
}

// ШУМ ВМЕСТЕ С НАКЛОНОМ. Наклон нормали раньше брался разностью: высота
// считалась ЧЕТЫРЕ раза подряд — сама и три сдвинутых, — то есть сто двадцать
// восемь выборок хеша на пиксель ради одного градиента. А производная
// трилинейной свёртки выражается через те же восемь углов, которые уже
// посчитаны: выходит вчетверо дешевле при том же рисунке.
//
// Возвращает (значение, наклон по x, по y, по z).
vec4 noised(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	vec3 u = f * f * (3.0 - 2.0 * f);
	vec3 du = 6.0 * f * (1.0 - f);
	float a = hash(i);
	float b = hash(i + vec3(1,0,0));
	float c = hash(i + vec3(0,1,0));
	float d = hash(i + vec3(1,1,0));
	float e = hash(i + vec3(0,0,1));
	float f1 = hash(i + vec3(1,0,1));
	float g = hash(i + vec3(0,1,1));
	float h = hash(i + vec3(1,1,1));
	float k1 = b - a;
	float k2 = c - a;
	float k3 = e - a;
	float k4 = a - b - c + d;
	float k5 = a - c - e + g;
	float k6 = a - b - e + f1;
	float k7 = -a + b + c - d + e - f1 - g + h;
	float v = a + k1 * u.x + k2 * u.y + k3 * u.z + k4 * u.x * u.y
		+ k5 * u.y * u.z + k6 * u.z * u.x + k7 * u.x * u.y * u.z;
	vec3 dv = du * vec3(
		k1 + k4 * u.y + k6 * u.z + k7 * u.y * u.z,
		k2 + k4 * u.x + k5 * u.z + k7 * u.z * u.x,
		k3 + k5 * u.y + k6 * u.x + k7 * u.x * u.y);
	return vec4(v, dv);
}

// Высота и её наклон за один проход. Искажение общее: его собственный наклон
// не учитываем — на глаз разницы нет, а это ещё три выборки.
// Мелкие октавы в наклоне придушены: прежняя разность с шагом шесть
// сантиметров их сама съедала, и без этого рельеф стал бы вдвое злее.
vec4 height_d(vec3 p, float t) {
	vec3 w = p + vec3(noise(p * 0.6 + vec3(0.0, t * 0.09, 0.0)) - 0.5) * 1.4;
	vec4 a = noised(w * 0.75);
	vec4 b = noised(w * 2.6);
	vec4 c = noised(w * 6.5);
	return vec4(a.x * 0.62 + b.x * 0.26 + c.x * 0.12,
		a.yzw * (0.62 * 0.75) + b.yzw * (0.26 * 2.6 * 0.80)
			+ c.yzw * (0.12 * 6.5 * 0.45));
}

// Высота массы. По ней и выпирают вершины, и наклоняется нормаль, — поэтому
// свет ложится ровно на те бугры, которые видно по силуэту.
float height(vec3 p, float t) {
	vec3 w = p + vec3(noise(p * 0.6 + vec3(0.0, t * 0.09, 0.0)) - 0.5) * 1.4;
	return noise(w * 0.75) * 0.62 + noise(w * 2.6) * 0.26 + noise(w * 6.5) * 0.12;
}

void vertex() {
	vec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float t = TIME * 0.35;
	// Медленно и неравномерно. Быстрое шевеление читается как «глюк», медленное —
	// как «оно живое». Безумие усиливает и то и другое.
	// НАРУЖУ втрое слабее, чем внутрь. Столкновения у стены плоские, и бугор,
	// вылезший в коридор на треть метра, игрок проходит насквозь — а задние
	// грани не рисуются, и в стене открывается дыра. Внутрь проваливаться можно
	// сколько угодно: туда всё равно не зайти.
	float h = height(wp, t) - 0.5;
	if (h > 0.0) {
		h *= 0.32;
	}
	VERTEX += NORMAL * h * bulge * (1.0 + madness * 1.8);
}

void fragment() {
	// INV_VIEW_MATRIX, а не MODEL_MATRIX. Во ФРАГМЕНТЕ Godot отдаёт VERTEX в
	// пространстве камеры, а не модели, — и старое умножение на MODEL_MATRIX
	// давало не мировую точку, а мусор. Отсюда две беды разом: расстояние до
	// стены считалось огромным, поэтому вся мелочь гасла; и рисунок был привязан
	// к камере, то есть полз вместе с головой, вместо того чтобы лежать на камне.
	vec3 wp = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float t = TIME * 0.35;
	float dist = length(CAMERA_POSITION_WORLD - wp);
	// Резко: мелочь живёт в трёх метрах и ближе. Дальше её нет ВООБЩЕ — не ради
	// экономии, а потому что сцена почти чёрная, и свечение в ней абсолютно.
	// Слабая засветка, незаметная при нормальном свете, здесь превращает весь
	// коридор в зелёный фонарь и убивает темноту, на которой держится игра.
	// Безумие не красит стену пятнами, а ВЫКРУЧИВАЕТ то, что уже живёт: мелочь
	// видно дальше, пятна шире, свечение сильнее. Раньше на потолке ярости
	// появлялись большие зелёные кляксы, которые не шевелились и не мигали —
	// просто краска. Их нет.
	float mad = clamp(madness, 0.0, 1.0);
	float near = (1.0 - smoothstep(0.7, near_dist * (1.0 + mad * 0.8), dist)) * detail;
	float near2 = near * near;

	// СКОЛЬКО ВООБЩЕ СЧИТАТЬ. Здесь на каждый пиксель приходилось под сто
	// семьдесят выборок шума: высота считалась четыре раза (сама и три для
	// градиента), и всё это ВСЕГДА — даже на стене в двадцати метрах, где ни
	// рельефа, ни мелочи не видно. На весь экран ретины это одно съедало
	// двадцать миллисекунд кадра, то есть игру.
	//
	// Отсечка по расстоянию честная, а не «на глаз»: мелочь и так живёт в трёх
	// метрах (near), а рельеф на десяти метрах в почти чёрном коридоре не
	// читается — там октавы мельче пикселя и дают не подробность, а рябь.
	float lod = 1.0 - smoothstep(5.0, 11.0, dist);
	float h0;
	vec3 n = normalize(NORMAL);
	if (lod > 0.002) {
		// РЕЛЬЕФ. Градиент высоты, из него — наклон нормали. Нормаль во фрагменте
		// живёт в пространстве камеры, а градиент считается в мировом, поэтому его
		// надо перевести, иначе рельеф разворачивается вместе с головой игрока.
		vec4 hd = height_d(wp, t);
		h0 = hd.x;
		vec3 gv = (VIEW_MATRIX * vec4(hd.yzw, 0.0)).xyz;
		NORMAL = normalize(n - (gv - dot(gv, n) * n) * relief * (0.45 + near * 0.55) * lod);
	} else {
		// Далеко нужна только неровная яркость, и хватает одной октавы.
		h0 = noise(wp * 0.75) * 0.62 + 0.19;
	}

	float lines = 0.0;
	float dotf = 0.0;
	float snow = 0.0;
	if (near > 0.003) {
		// ГДЕ МЕЛОЧЬ ВООБЩЕ ЕСТЬ. Без этой маски линии и помеха покрывают всю
		// поверхность, и стена читается зелёной, — а она должна быть чёрной массой,
		// на которой лишь МЕСТАМИ что-то проступает. Пятна медленно переползают,
		// так что одно и то же место то живое, то мёртвое.
		float lo = mad * 0.17;
		float patch = smoothstep(0.44 - lo, 0.74 - lo, noise(wp * 0.5 + vec3(0.0, t * (0.06 + mad * 0.22), 0.0)))
			* smoothstep(0.30 - lo, 0.60 - lo, noise(wp * 1.7 - vec3(0.0, t * (0.04 + mad * 0.16), 0.0)));

		// ЛИНИИ. Гребни искажённого шума: тонкие, ветвятся, никогда не параллельны.
		vec3 lw = wp + vec3(noise(wp * 1.3 + vec3(0.0, t * 0.15, 0.0)) - 0.5) * 2.0;
		lines = (pow(clamp(1.0 - abs(noise(lw * 4.5) * 2.0 - 1.0), 0.0, 1.0), 34.0)
			+ pow(clamp(1.0 - abs(noise(lw * 13.0) * 2.0 - 1.0), 0.0, 1.0), 38.0) * 0.7
			+ pow(clamp(1.0 - abs(noise(lw * 31.0) * 2.0 - 1.0), 0.0, 1.0), 42.0) * 0.5) * patch;

		// ТОЧКИ. Сетка ячеек, в редких сидит крапина. Живут по несколько секунд
		// и гаснут — стоячие точки читались бы как грязь на экране.
		vec3 cell = floor(wp * 40.0);
		float pick = hash(cell);
		float life = fract(pick * 7.31 + t * 0.5);
		dotf = smoothstep(0.26, 0.05, length(fract(wp * 40.0) - 0.5))
			* step(0.86, pick) * smoothstep(0.0, 0.2, life) * smoothstep(1.0, 0.7, life) * patch;

		// ТЕЛЕВИЗИОННЫЙ ШУМ. Квантован и по месту, и по времени: шестнадцать «кадров»
		// в секунду. Плавный шум читается как туман, ступенчатый — как помеха.
		// Ячейка около миллиметра. При крупной (четыре миллиметра) вблизи получались
		// не помехи, а квадраты в палец величиной: вплотную одна ячейка занимает
		// десятки пикселей. Помеха обязана оставаться мельче того, что она покрывает.
		snow = hash(floor(wp * 900.0) + floor(t * 46.0));
		snow = smoothstep(0.86 - mad * 0.13, 1.0, snow) * buzz * near2 * patch;
	}

	// СБОРКА. Масса почти чёрная: свет палочки выхватывает только рельеф.
	vec3 col = mix(base_color, mad_color, madness);
	col *= 0.55 + h0 * 0.9;
	col += vec3(0.12, 0.13, 0.13) * lines * near * 0.5;
	col += vec3(0.11) * snow * 0.22;

	// Свечение ТОЛЬКО вблизи. Оно и делает «жужжание»: линии, крапины и помеха
	// мигают сами по себе, и рассмотреть их можно, лишь подойдя к стене.
	float glow = lines * 0.30 + dotf * 1.2 + snow * 0.35;
	// Было (0.5 + mad * 1.7) — на потолке стена жгла глаза и мешала смотреть.
	// Заметность там берётся не яркостью, а тем, что мелочи БОЛЬШЕ и она ближе.
	vec3 em = mix(spark_color, mad_spark, mad) * glow * near2 * (0.5 + mad * 0.65);

	// ЗЕРНО. Рельеф здесь крупный — он лепит силуэт и тени, — а вблизи, в пятне
	// фонаря, камень оставался серой размазнёй: ни крошки, ни грани. На кадре
	// со светом это видно сразу, и выглядит как дым, а не как порода.
	//
	// Мелкую крошку берём производными от скалярной высоты: видеокарта считает
	// dFdx/dFdy и так, для выбора уровня текстур, поэтому две октавы шума
	// обходятся почти даром. Тем же приёмом сделана кожа твари.
	//
	// Гасим вместе с lod: на десяти метрах октава мельче пикселя и даёт рябь,
	// а не подробность.
	// Частоты и сила подобраны по кадру: на 23 и 57 с силой 16 камень читался
	// наждаком — равномерная крошка во всю стену. Крупнее и слабее — и это
	// снова порода, у которой есть и гладкие места, и шершавые.
	float grain = 0.5;
	if (grain_k > 0.01 && lod > 0.002) {
		grain = noise(wp * 13.0) * 0.66 + noise(wp * 31.0) * 0.34;
		NORMAL = normalize(NORMAL
			+ vec3(dFdx(grain), -dFdy(grain), 0.0) * 9.0 * lod * grain_k);
	}

	ALBEDO = col;
	EMISSION = em;
	// ШЕРОХОВАТОСТЬ ОТ ЗЕРНА, а не одно число на всю стену. Ровная
	// шероховатость даёт ровный отблеск, и любая поверхность под ней читается
	// как пластик — сколько бы рельефа на ней ни было.
	// Без зерна grain остаётся серединой — шероховатость просто ровная, как и
	// было до этой правки.
	ROUGHNESS = clamp(0.80 + (grain - 0.5) * 0.36 * grain_k + 0.09 - near * 0.06,
		0.66, 0.99);
	METALLIC = 0.0;
	SPECULAR = 0.10 + (1.0 - grain) * 0.10 * grain_k;
}
