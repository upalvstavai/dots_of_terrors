shader_type canvas_item;
// Затемнение по краям вместо глухой заливки.
//
// Раньше захват закрывал экран на 80–98%, и получалось, что игра ПРЯЧЕТ мир в
// тот самый момент, который называет страшным. А страшно не то, что тебя
// схватили, — страшно, что пока тебя держат, к тебе идут. Значит это надо
// видеть.

uniform float grip : hint_range(0.0, 1.0) = 0.5;
uniform vec3 tint : source_color = vec3(0.05, 0.016, 0.016);

void fragment() {
	vec2 d = UV - vec2(0.5);
	// Не круг, а вытянутый овал: кадр шире, чем выше, и круглая виньетка
	// съедает бока сильнее, чем нужно.
	d.x *= 0.78;
	float r = length(d) * 2.0;
	// Края давят сильнее по мере того, как хватка крепнет. Середина остаётся
	// прозрачной всегда — иначе смысл пропадает.
	float edge = smoothstep(0.45 - grip * 0.22, 1.15, r);
	float a = edge * (0.55 + grip * 0.42);
	COLOR = vec4(tint, clamp(a, 0.0, 1.0));
}
