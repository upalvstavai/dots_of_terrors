## «Заново» из паузы — это НАЧАТЬ СНАЧАЛА: и карта прежняя, и полотна в ноль.
## У смерти путь другой, он ниже.
func _restart() -> void:
	carry_seed = 0
	carry_keep = false
	get_tree().reload_current_scene()


## ПОСЛЕ СМЕРТИ — ТА ЖЕ КАРТА И ТО, ЧТО УСПЕЛ. Раньше здесь была новая карта
## и всё заново; см. carry_keep. Сданные полотна, палочка и карта остаются,
## просыпаешься в убежище, ближайшем к месту смерти, безумие — ступенью ниже.
func _restart_after_death() -> void:
	carry_seed = _seed_used if _seed_used != 0 else 1
	carry_keep = true
	carry_done = done
	var st: int = _madness_stage()
	carry_errors = 0 if st < 2 else int(MAD_STAGE[st - 2])
	carry_wand = has_wand or dropped_wand != null
	carry_cell = _nearest_safe() if player_node != null else start_cell
	get_tree().reload_current_scene()


## Вернуть то, что пережило смерть. Зовётся один раз, когда мир собран.
func _apply_carry() -> void:
	if not carry_keep:
		return
	carry_keep = false
	done = clampi(carry_done, 0, n_canv)
	errors = carry_errors
	canvas_arm = true
	_refresh_marks()
	if carry_wand:
		for t in tables:
			if t["wand"]:
				t["read"] = true
				if t.has("wand_node") and is_instance_valid(t["wand_node"]):
					(t["wand_node"] as Node3D).visible = false
		has_wand = true
		if wand_lamp != null:
			wand_lamp.visible = true
		if wand_view != null:
			wand_view.visible = true
		if player_node != null:
			player_node.has_wand = true
	if player_node != null and carry_cell.x >= 0 and not maze.is_wall(carry_cell.x, carry_cell.y):
		player_node.global_position = cell_to_world(carry_cell, PlayerScript.STAND_Y)
	print("[журнал] после смерти: полотен %d, ошибок %d, палочка %s, убежище %s" % [
		done, errors, str(has_wand), str(carry_cell)])


## Все шесть столбов стояли одинаково зелёными с первой секунды, и понять, какой
## сейчас живой, было нельзя: игрок проходил сквозь дальний и решал, что тот сломан.
## Живой горит ярко, пройденные гаснут, будущие едва тлеют.
func _refresh_marks() -> void:
	for i in canv_marks.size():
		var mat: StandardMaterial3D = canv_marks[i].material_override
		# Сила свечения ЗДЕСЬ перебивала ту, что задана при создании метки, и
		# фактура снова тонула в ровной заливке. Держим её низкой: метку и так
		# видно издалека, а вблизи должно быть понятно, что это вещь.
		if i < done:
			mat.albedo_color = Color(0.20, 0.26, 0.22)
			mat.emission = Color(0.10, 0.16, 0.13)
			mat.emission_energy_multiplier = 0.10
		elif i == done:
			mat.albedo_color = Color(0.42, 0.90, 0.62)
			mat.emission = Color(0.22, 1.0, 0.62)
			mat.emission_energy_multiplier = 0.55
		else:
			mat.albedo_color = Color(0.28, 0.48, 0.36)
			mat.emission = Color(0.16, 0.40, 0.28)
			mat.emission_energy_multiplier = 0.20
	if exit_mark != null:
		var em: StandardMaterial3D = exit_mark.material_override
		var live := done >= n_canv
		em.emission_energy_multiplier = 0.75 if live else 0.12


