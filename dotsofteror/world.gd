## Выхода нет. Есть стена, и дверь надо НАРИСОВАТЬ — тем самым действием, которым
## игрок занимался всю игру. Раньше добежал до выхода — и просто менялась надпись
## в углу; последние тридцать секунд, то есть ровно то, что человек потом
## пересказывает, были пустыми.
## Вместо таймера — он сам. Встаёт в четырнадцати клетках и идёт по коридору;
## полоска над доской не убывает, а НАПОЛНЯЕТСЯ по мере его приближения.
## Идёт медленно и только коридорами: у игрока должно быть ровно столько времени,
## сколько монстру идти, — не больше и не меньше.
const FINAL_DIST := 14
const FINAL_SPEED := 0.27      ## клеток в секунду

func _open_finale() -> void:
	finale = true
	board.final = true
	if monster != null and player_node != null:
		monster.to_finale(world_to_cell(player_node.global_position), FINAL_DIST, FINAL_SPEED)
	board.open(Shapes.DOOR, 0, fear, _madness_stage(), _rng.randi())
	board.visible = true
	_board_to_wall()
	_pause_player(true)
	hud.text = Lang.t("h_drawdoor")


## Дорисовал — впервые за всю игру появляется свет. Он бьёт из двери, которую
## игрок только что нарисовал.
func _win() -> void:
	# ДВЕРЬ НАРИСОВАНА — И ЭТО НЕ СПАСЕНИЕ.
	#
	# Раньше здесь была вспышка и надпись «ты выбрался». Добивание же
	# доставалось только тому, кого поймали трижды, то есть игроку, который
	# играет плохо, — а это лучшее, что в игре есть. Нормальный человек
	# проходил её и не видел единственной сцены, ради которой всё писалось.
	#
	# Теперь последнее полотно — это конец: ты дорисовал дверь, за спиной
	# трещит камень, ты оборачиваешься, и он идёт к тебе. Медленно, потому что
	# торопиться ему больше некуда.
	won = true
	finale = false
	if sfx != null:
		# Короткий светлый звук всё-таки есть: дверь он нарисовал. Ровно на
		# секунду — чтобы было чему оборваться.
		sfx.play("win", 2.0, 0.04)
		sfx.amb_duck(8.0)
	board.visible = false
	board.set_process(false)
	# И ЛИСТ СО СТЕНЫ СНИМАЕМ: дверь нарисована, дальше её место занимает
	# концовка, а светящийся лист посреди коридора в ней лишний.
	if board_face != null:
		board_face.visible = false
	hud.text = ""
	# Курсор НЕ отпускаем: _pause_player открывает мышь, а открытая мышь — это
	# paused(), и весь _process встаёт вместе с концовкой.
	_freeze_player(true)
	_set_cursor(false)
	if monster == null or player_node == null:
		_show_end_text()
		return
	# Ставим его так, чтобы его было ВИДНО с места игрока: концовка не должна
	# начинаться с того, что он идёт сквозь стену.
	var pc: Vector2i = world_to_cell(player_node.global_position)
	var dist: Dictionary = maze.distances(pc)
	var best: Vector2i = pc
	var bd: int = 1 << 30
	for c in dist:
		if maze.is_wall(c.x, c.y):
			continue
		if not maze.los(c, pc):
			continue
		var d: int = absi(int(dist[c]) - 5)
		if d < bd:
			bd = d
			best = c
	monster.finale_mode = false
	monster.parked = true          # ведём его сами, шаг в шаг со сценой
	monster.mode = "chase"
	monster.stun = 0.0
	monster.path.clear()
	monster.visible = true
	monster.set_lit(1.0)
	monster._grow_out()
	monster.global_position = cell_to_world(best)
	if sfx != null:
		sfx.play_at("scrape", monster.global_position, 4.0)
	ending = 1
	end_t = 0.0


## ПОДХОД. Камера поворачивается к нему сама — это и есть «обернулся», — а он
## идёт шагом, полтора метра в секунду. Ни рывка, ни погони: догонять больше
## некого.
func _update_ending(delta: float) -> void:
	if ending != 1 or monster == null or player_node == null:
		return
	end_t += delta
	player_node.look_force(monster.look_point(), 0.4, 2.2)
	var to: Vector3 = player_node.global_position - monster.global_position
	to.y = 0.0
	var d: float = to.length()
	if d > 2.3 and end_t < 16.0:
		var m: float = delta * 1.35
		monster.global_position += to.normalized() * m
		monster.look_at(monster.global_position - to, Vector3.UP)
		# ШАГИ ПОДХОДА. Тут он движется не путём по клеткам, а вручную, и
		# собственные шаги твари молчали ровно в той сцене, где важнее всего
		# слышать, как она подходит со спины. Считаем метры сами.
		end_walk += m
		if end_walk >= 1.15:
			end_walk = 0.0
			if sfx != null:
				sfx.stomp(monster.global_position, 1.0)
		return
	ending = 2
	fat_ending = true
	monster.parked = false
	_start_fatality()


func _show_end_text() -> void:
	var back := ColorRect.new()
	back.color = Color(0, 0, 0, 0.0)
	back.set_anchors_preset(Control.PRESET_FULL_RECT)
	back.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hud.get_parent().add_child(back)
	var lbl := Label.new()
	lbl.text = Lang.t("end_text")
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	lbl.set_anchors_preset(Control.PRESET_FULL_RECT)
	# Концовка — единственное место, где игра говорит от себя, и говорит она
	# книжной антиквой: тем же шрифтом, что и заглавие.
	lbl.add_theme_font_override("font", UI.title(400, 2))
	lbl.add_theme_color_override("font_color", UI.INK)
	lbl.add_theme_font_size_override("font_size", 30)
	lbl.add_theme_constant_override("line_spacing", 12)
	lbl.modulate.a = 0.0
	back.add_child(lbl)
	var tw := create_tween()
	tw.tween_property(back, "color:a", 1.0, 1.6)
	tw.tween_property(lbl, "modulate:a", 1.0, 1.4)
	_set_cursor(true)


func _show_win_text(flash: ColorRect) -> void:
	var lbl := Label.new()
