shader_type canvas_item;
render_mode unshaded;

// ЯРКОСТЬ ЭКРАНА. Игра тёмная намеренно, но экран у каждого свой: на матовой
// матрице ноутбука днём коридор — просто чёрный прямоугольник, и всю работу
// со светом человек не увидит вовсе.
//
// Почему степень, а не умножение. Умножение (Environment.adjustment_brightness)
// применяется ПОСЛЕ тонмаппинга: пиксель 0.02 при множителе 1.5 станет 0.03 —
// был чёрный, остался чёрный. Степень поднимает именно тёмное: 0.02 в степени
// 1/1.6 — это уже 0.09, вчетверо. Светлое при этом почти не трогается, и
// палочка не превращается в белое пятно.
//
// ПОДНИМАЕТ ТЕНЬ, А НЕ СВЕТ. Степень тянула кадр ЦЕЛИКОМ, и вместе с камнем
// вверх ехало пятно от палочки. На верхнем краю коридор переставал быть тёмным
// — ползунок яркости превращался в ползунок «отключить темноту», то есть в
// читерский. А темнота здесь не недостаток картинки, она и есть игра.
//
// Поэтому поднятое подмешиваем ТОЛЬКО там, где было темно, и отпускаем к
// исходному по мере того, как пиксель становится светлее. Тень читается, пятно
// от палочки остаётся ровно таким, каким нарисовано, и контраст между ними —
// тоже. Порог взят по свету палочки: её середина ярче 0.55, её край около 0.18.
uniform sampler2D screen_tex : hint_screen_texture, filter_nearest;
uniform float gamma : hint_range(0.5, 1.6) = 1.0;

void fragment() {
	vec3 c = max(texture(screen_tex, SCREEN_UV).rgb, vec3(0.0));
	vec3 up = pow(c, vec3(1.0 / gamma));
	float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
	COLOR = vec4(mix(up, c, smoothstep(0.18, 0.55, lum)), 1.0);
}
