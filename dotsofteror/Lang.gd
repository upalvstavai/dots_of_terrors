## Ключа нет ни в одном словаре — возвращаем сам ключ. Пропущенная строка должна
## бросаться в глаза на экране, а не падать игрой у игрока.
static func t(key: String) -> String:
	var d: Dictionary = EN if Settings.lang == "en" else RU
	if d.has(key):
		return str(d[key])
	if RU.has(key):
		return str(RU[key])
	return "[" + key + "]"


static func toggle() -> void:
	Settings.set_lang("en" if Settings.lang == "ru" else "ru")


## СКЛОНЕНИЕ ДНЕЙ. «Тебя не было 2 дней» ломает самую страшную фразу в наборе
## быстрее, чем что угодно другое: игрок замечает ошибку и вспоминает, что перед
## ним программа. По-английски правило проще, но ветка одна на оба языка.
static func days(n: int) -> String:
	var a: int = n % 100
	if a >= 11 and a <= 14:
		return t("d_many")
	match n % 10:
		1:
			return t("d_one")
		2, 3, 4:
			return t("d_few")
	return t("d_many")
