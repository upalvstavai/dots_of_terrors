shader_type spatial;
// ПОДПОВЕРХНОСТНОГО РАССЕИВАНИЯ ЗДЕСЬ НЕТ, И ЭТО ДВА ЗАМЕРА.
//
// Первый: при 0.65 фигура на кадре вышла ТЕМНЕЕ и ПЛОЩЕ, чем без него. У шкуры
// альбедо 0.032 — рассеивать нечего, зато размылся ровно тот боковой свет, ради
// которого всё и затевалось.
//
// Второй, и он дороже: одно объявление `sss_mode_skin` в шейдере включает
// полноэкранный проход рассеивания на ВЕСЬ кадр — независимо от того, видно ли
// фигуру и стоит ли сила в ноль. Замер одной и той же сценой: 107 кадров до,
// 57 после, при том же числе вызовов отрисовки. Половина кадра за эффект,
// который и выглядел хуже.
render_mode cull_disabled, diffuse_burley;
// ЖИЖА ДЛЯ МОДЕЛИ С КОСТЯМИ.
//
// У кома жижа сделана смещением вершин: поверхность кипит и течёт. На скиненном
// меше так нельзя — я попробовал, и фигуру разорвало на отдельные треугольники,
// разлетевшиеся на несколько метров. Скиннинг в Godot применяется ПОСЛЕ
// пользовательской vertex(), и смещение считается в позе покоя: на вытянутых
// вдвое костях это расходится тем сильнее, чем дальше вершина от кости.
//
// Поэтому здесь только ПОВЕРХНОСТЬ: тот же чёрный тон, та же мокрая кромка, та
// же отзывчивость к близости игрока. Кипения нет — его отыгрывает силуэт,
// который и так изломан искажением костей.
//
// РЕЛЬЕФ. Раньше здесь были ровный чёрный цвет и одна шероховатость на всю
// фигуру — и гуманоид читался пластмассовой куклой: свет ложился по нему
// гладким пятном, потому что на всей поверхности не было ни одной неровности.
//
// ПРИВЯЗКА ШУМА. Не к UV: у этой модели развёртки нет вовсе — я вывел UV
// цветом, и фигура вышла угольно-чёрной, то есть там нули. Не к экрану и не к
// миру: по ним узор плыл бы под шкурой на каждом шаге. Привязка — к позе
// покоя. То самое свойство, из-за которого нельзя двигать вершины (скиннинг
// идёт после vertex()), здесь работает на нас: VERTEX в vertex() — это
// неподвижная точка на теле, за неё и держится вся шкура.

uniform vec3 base_color : source_color = vec3(0.032, 0.036, 0.034);
uniform vec3 rim_color : source_color = vec3(0.14, 0.40, 0.24);
uniform float lit : hint_range(0.0, 1.0) = 0.0;
uniform float wet = 1.0;
uniform float grain : hint_range(0.0, 3.0) = 1.0;

varying vec3 rest;

float h31(vec3 p) {
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float vnoise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = mix(mix(h31(i), h31(i + vec3(1.0, 0.0, 0.0)), f.x),
		mix(h31(i + vec3(0.0, 1.0, 0.0)), h31(i + vec3(1.0, 1.0, 0.0)), f.x), f.y);
	float b = mix(mix(h31(i + vec3(0.0, 0.0, 1.0)),
			h31(i + vec3(1.0, 0.0, 1.0)), f.x),
		mix(h31(i + vec3(0.0, 1.0, 1.0)), h31(i + vec3(1.0, 1.0, 1.0)), f.x), f.y);
	return mix(a, b, f.z);
}

float fbm(vec3 p) {
	float s = 0.0;
	float a = 0.5;
	for (int k = 0; k < 3; k++) {
		s += a * vnoise(p);
		p *= 2.07;
		a *= 0.5;
	}
	return s;
}

void vertex() {
	rest = VERTEX;
}

void fragment() {
	// Крупные натёки: по ним идёт разница «мокрое — подсохшее».
	float g = fbm(rest * 5.0);
	// ПОДТЁКИ. По телу течёт вниз, поэтому шум сжат по вертикали в шесть раз:
	// получаются полосы сверху вниз, а не ровная крупа.
	float drip = fbm(vec3(rest.x * 26.0, rest.y * 4.0, rest.z * 26.0));
	// Мелкая шкура и её уклон — четыре выборки со сдвигом по осям.
	vec3 p = rest * 13.0;
	float e = 0.5;
	float f0 = vnoise(p);
	vec3 gr = vec3(vnoise(p + vec3(e, 0.0, 0.0)) - f0,
		vnoise(p + vec3(0.0, e, 0.0)) - f0,
		vnoise(p + vec3(0.0, 0.0, e)) - f0);
	// Развёртки нет, значит нет и касательных: нормаль правим напрямую.
	// Уклон шума считается в позе покоя, поэтому его надо перевести в тот же
	// вид, в котором лежит NORMAL.
	vec3 n0 = normalize(NORMAL);
	// Кромка считается по ГЛАДКОЙ нормали. По изрытой она загорается по всей
	// туше разом, и фигура светится зелёным целиком вместо мокрого контура.
	float rim = pow(1.0 - abs(dot(n0, normalize(-VERTEX))), 1.7);
	vec3 grv = (VIEW_MATRIX * MODEL_MATRIX * vec4(gr, 0.0)).xyz;
	NORMAL = normalize(n0 - (grv - dot(grv, n0) * n0) * grain * 2.4);
	ALBEDO = base_color * (0.45 + 1.15 * g + 0.20 * drip) * (1.0 + lit * 3.0);
	if (grain > 2.5) { ALBEDO = vec3(0.62); NORMAL = normalize(n0); }
	EMISSION = rim_color * rim * (0.34 + lit * 0.9) * wet * (0.75 + 0.5 * drip);
	if (grain > 2.5) { EMISSION = vec3(0.0); ROUGHNESS = 0.55; SPECULAR = 0.3; }
	// Блик размазан, а не точка: два источника света давали на глянце два
	// белых кружка, читавшихся как лишние глаза. А теперь он ещё и рваный:
	// одинаковая гладкость по всей туше и делала из неё пластик. Там, где
	// натекло, — почти зеркало; где подсохло — матовое.
	// Пол снизу поднят до 0.34: ниже на спине загоралось зеркальное белое
	// пятно — ровно тот блик, по которому пластмассу и узнают.
	ROUGHNESS = clamp(0.68 - 0.20 * drip - 0.06 * wet + 0.24 * f0, 0.45, 0.95);
	SPECULAR = 0.06 + 0.12 * drip;
	METALLIC = 0.0;
}
