shader_type spatial;
// cull_disabled, а не cull_back. В хвате игрок оказывается вплотную к туше, и
// стоит поверхности качнуться наружу — камера внутри. С отсечением задних граней
// изнутри тело ПРОЗРАЧНО: сквозь него видны собственные щупальца и весь коридор.
// Без отсечения изнутри видна чёрная изнанка — то, что и должно быть внутри массы.
render_mode cull_disabled, diffuse_burley;
// Тело монстра — ОДНА поверхность.
//
// Две предыдущие попытки провалились по одной причине: тело собиралось из
// множества отдельных мешей. У каждого свой силуэт, и глаз честно читает то,
// что есть, — связку палок или гусеницу из шариков. Комком это не станет
// никогда, сколько их ни двигай.
//
// Здесь один шар, и вся форма — смещение его вершин. Поэтому силуэт всегда
// СПЛОШНОЙ: у жидкой массы не бывает щелей между частями.
//
// Форма задаётся притягивателями: восемь точек, к которым поверхность тянется.
// В покое они жмутся к центру со слабой силой — выходит бесформенный ком. Для
// фигуры расходятся по конечностям, и та же самая поверхность вытягивается в
// руки и ноги, не разрываясь.

uniform vec3 base_color : source_color = vec3(0.030, 0.034, 0.032);
uniform vec3 rim_color : source_color = vec3(0.14, 0.40, 0.24);
uniform float wobble = 0.30;                       // сила кипения поверхности
uniform float form : hint_range(0.0, 1.0) = 0.0;   // 0 — ком, 1 — фигура
// РАСТЕКАНИЕ. 0 — масса собрана в ком, 1 — расплылась и осела. Гоняется
// пилообразно: медленно растекается, быстро подбирается назад. Ровно как
// языки жижи на ободе пролома — оттуда и взято, там это читается лучше всего.
uniform float spread : hint_range(0.0, 1.0) = 0.0;
// БЛИЗОСТЬ. Тело почти чёрное (альбедо 0.03), и никакой фонарь его не вытащит:
// от трёх процентов отражения нечему отражаться. Поэтому вблизи мы поднимаем
// саму отзывчивость поверхности к свету, а не только яркость лампы.
uniform float lit : hint_range(0.0, 1.0) = 0.0;
// КУДА СМЕЩАТЬ ВЕРШИНЫ. 1 — от центра меша (так устроен ком: он и есть шар).
// 0 — вдоль нормали. Для человеческой фигуры центр находится где-то в тазу, и
// смещение «от центра» раздувало бы её воздушным шаром вместо кипения кожи.
uniform float radial : hint_range(0.0, 1.0) = 1.0;
// ГЛАЗА ЖИВУТ ЗДЕСЬ, а не отдельными мешами. Меши я пробовал: поверхность
// кипит и раздувается притягивателями на треть радиуса, и глаз, посаженный
// хоть на радиус, хоть на 1.02 радиуса, попросту тонул в массе — на замере
// пикселя под ним оказывалось тело, а не глаз. Нарисованный в шейдере, он
// всегда РОВНО на поверхности, сколько бы её ни выгибало.
// xyz — направление на глаз от центра, w — насколько открыт.
uniform vec4 eye0;
uniform vec4 eye1;
uniform vec4 eye2;
uniform vec4 eye3;
uniform vec4 eye4;
uniform vec4 eye5;
uniform vec3 eye_color : source_color = vec3(0.95, 0.30, 0.20);
// ПАСТЬ. xyz — куда смотрит, w — насколько широкая. Рисуется здесь по той же
// причине, что и глаза: поверхность кипит и раздувается, и любая накладка
// отдельным мешем в ней тонет. Нарисованная — всегда ровно на теле.
uniform vec4 mouth = vec4(0.0, 1.0, 0.0, 0.0);
uniform float mouth_open = 0.0;
uniform float eye_glow = 1.6;
varying vec3 vdir;

uniform vec4 attr0;
uniform vec4 attr1;
uniform vec4 attr2;
uniform vec4 attr3;
uniform vec4 attr4;
uniform vec4 attr5;
uniform vec4 attr6;
uniform vec4 attr7;

float hash(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
		mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y),
		f.z);
}

// Одна точка тянет поверхность к себе. Спад мягкий и широкий: жёсткий давал бы
// шишку, а нам нужен наплыв, переходящий в тело без границы.
float pull(vec3 p, vec4 a) {
	if (a.w <= 0.001) {
		return 0.0;
	}
	float d = length(p - a.xyz);
	// Спад мягче (1.1 вместо 2.1): при большом теле точки притяжения стоят
	// дальше друг от друга, и на резком спаде каждая давала шишку у себя под
	// носом, а между ними тело оставалось прежним.
	// 1.1. На 0.7 каждая точка тянула ВСЁ тело, и вместо фигуры получался
	// раздутый шар — проверено кадром.
	return a.w * exp(-d * d * 1.1);
}

// Кипение: три частоты, все ползут во времени с разной скоростью. Одна частота
// читается как рябь, три — как то, что внутри переливается.
float boil(vec3 p, float t) {
	return noise(p * 1.7 + vec3(0.0, t * 0.55, 0.0)) * 0.55
		+ noise(p * 3.9 - vec3(t * 0.4, 0.0, 0.0)) * 0.28
		+ noise(p * 8.3 + vec3(0.0, 0.0, t * 0.7)) * 0.17;
}

float field(vec3 p, float t) {
	float b = (boil(p, t) - 0.5) * wobble;
	float s = pull(p, attr0) + pull(p, attr1) + pull(p, attr2) + pull(p, attr3)
		+ pull(p, attr4) + pull(p, attr5) + pull(p, attr6) + pull(p, attr7);
	return b + s;
}

void vertex() {
	float t = TIME;
	vec3 dir = normalize(VERTEX);
	// Направление ДО смещения: устойчивая «развёртка» по телу.
	vdir = dir;
	vec3 push = mix(normalize(NORMAL), dir, radial);
	VERTEX += push * field(VERTEX, t);
	// Растекание: низ оседает и расходится вширь, верх проваливается следом.
	// Не равномерное сжатие — тогда это просто пульсирующий шар, а не масса,
	// которая теряет и снова набирает высоту.
	float low = clamp(0.5 - VERTEX.y * 0.8, 0.0, 1.0);
	VERTEX.xz *= 1.0 + spread * 0.42 * low;
	VERTEX.y -= spread * 0.30 * (1.0 - low * 0.4);
	// Кости скелета двигают вершины ПОСЛЕ вершинной функции, поэтому кипение
	// здесь ложится на позу — как и надо: кипит кожа, а не мешок.
}

void fragment() {
	// Нормаль по градиенту того же поля: без этого свет ложится на исходный шар,
	// и вся возня с вершинами видна только по краю силуэта.
	vec3 wp = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float rim = pow(1.0 - abs(dot(normalize(NORMAL), normalize(-VERTEX))), 1.7);
	ALBEDO = base_color * (1.0 + lit * 3.0);
	// Мокрая кромка — единственное, по чему чёрную массу видно в темноте.
	// В фигуре светится сильнее: она держится через силу, и это заметно.
	EMISSION = rim_color * rim * (0.34 + form * 0.7 + lit * 0.9);
	// БЛИК РАЗМАЗАН, А НЕ ТОЧКА. При 0.22 глянцевая туша ловила два фонаря —
	// свет палочки и отдельный луч по монстру — и давала два белых кружка на
	// теле. На кадре они читались как лишние белые глаза, хотя это отражение.
	// Мокрым он остаётся за счёт свечения кромки, а не зеркальности.
	// Щель, а не точка: перед сравнением сплющиваем направление по вертикали,
	// и пятно вытягивается поперёк — получается глаз, а не лампочка.
	vec3 sq = normalize(vec3(vdir.x, vdir.y * 3.4, vdir.z));
	float lids = 0.0;
	vec4 es[6] = {eye0, eye1, eye2, eye3, eye4, eye5};
	for (int i = 0; i < 6; i++) {
		if (es[i].w <= 0.001) {
			continue;
		}
		vec3 ed = normalize(vec3(es[i].x, es[i].y * 3.4, es[i].z));
		lids += smoothstep(0.986, 0.9992, dot(sq, ed)) * es[i].w;
	}
	EMISSION += eye_color * lids * eye_glow;
	// Пасть: внутри почти чёрное, по краю — мокрый ободок. Дыра, а не пятно.
	if (mouth.w > 0.001 && mouth_open > 0.001) {
		float mc = dot(normalize(vdir), normalize(mouth.xyz));
		float mm = smoothstep(1.0 - mouth.w, 1.0 - mouth.w * 0.22, mc) * mouth_open;
		// Провал ПОЛНЫЙ, без подмешивания: пасть — это дыра, а не тёмное пятно.
		ALBEDO = mix(ALBEDO, vec3(0.003, 0.004, 0.004), min(1.0, mm * 1.6));
		// Ободок ярче всего там, где край: произведение m*(1-m) даёт кольцо.
		EMISSION += rim_color * (mm * (1.0 - mm) * 4.0) * (0.8 + form);
	}
	// ШКУРА, А НЕ ПЛАСТМАССА. Шероховатость и блик стояли КОНСТАНТАМИ на всю
	// тушу: сколько бы поверхность ни кипела, свет ложился по ней идеально
	// ровно — а ровный отблик глаз читает как гладкий пластик. Кипение меняло
	// силуэт, но не кожу.
	//
	// Мелкий рельеф берём из того же шума, что кипятит вершины, но на порядок
	// мельче и БЕЗ времени: крупное движение уже есть, а эта чешуя обязана
	// стоять на месте, иначе тело выглядит текущей водой.
	//
	// Ключ — vdir, направление ДО смещения: рисунок приклеен к телу и не
	// плывёт, когда массу вытягивает в конечность.
	float sk = noise(vdir * 27.0) * 0.64 + noise(vdir * 63.0) * 0.36;
	// Бугры — из экранной производной той же высоты. Это даром: градиент уже
	// посчитан железом для мип-уровней. Считать его отдельными выборками шума
	// значило бы вчетверо больше хешей на пиксель, а туша занимает пол-экрана.
	NORMAL = normalize(NORMAL + vec3(dFdx(sk), -dFdy(sk), 0.0) * 34.0);
	// МОКРОЕ ПЯТНАМИ, а не целиком. Ровная мокрота — это лак; настоящая плёнка
	// где-то стекла, где-то подсохла коркой. Нижняя граница ниже прежних 0.55
	// (там блестит), верхняя выше (там матовое).
	ROUGHNESS = clamp(0.28 + sk * 0.58, 0.24, 0.88);
	SPECULAR = 0.16 + (1.0 - sk) * 0.30;
	METALLIC = 0.0;
}
