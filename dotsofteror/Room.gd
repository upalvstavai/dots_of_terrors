func _ready() -> void:
	# Звук тот же, что дальше. Тихий пролог, а потом лабиринт с гулом — это
	# слышно как «включили игру», и вход перестаёт быть частью игры.
	sfx = SfxScript.new()
	add_child(sfx)
	sfx.amb_level(0.12)
	# ШКАТУЛКА. В комнате играет её мотив — тихо, будто крутится где-то рядом.
	# Всё, что дальше случится с этой мелодией, случится в лабиринте.
	sfx.box_level(0.55)
	# Яркость игрока — с первого кадра, а не со второй сцены: детская и есть
	# первое, что он видит, и если у него тут темно, дальше он не пойдёт.
	Settings.attach_gamma(self)
	_build_room()
	# СМОТРОВАЯ ДЛЯ ПРОЛОМА. Пролог идёт две с лишним минуты, а посмотреть
	# надо на дыру в полу — «края дрожат как двери». Ключ «-- дыра» открывает
	# пролом сразу, ставит игрока перед ним и снимает пару кадров подряд с
	# НЕПОДВИЖНОЙ камерой: дрожь — это разница между соседними кадрами, и
	# ловить её надо ими, а не глазом.
	if OS.get_cmdline_user_args().has("дыра"):
		_hole_probe.call_deferred()
	# СМОТРОВАЯ ДЛЯ УЛИЦЫ. Дома вдали играющий описал как «гладкие кубы с
	# окнами»: судить об этом можно только с того места, откуда он их видел, —
	# с начала тротуара. Ключ «-- улица» снимает три кадра оттуда.
	if OS.get_cmdline_user_args().has("улица"):
		_street_probe.call_deferred()
	_build_stuff()
	player = PlayerScene.instantiate()
	add_child(player)
	# ВХОДИТ. Не «оказывается в комнате», а входит: стоит в дверях, дверь за
	# спиной, и первые две секунды идёт сам. Разница в одном — становится
	# понятно, что комната ЧУЖАЯ и он сюда зашёл.
	# НА ПОРОГЕ УЛИЦЫ, А НЕ В ДЕТСКОЙ. Первый заход ставил игрока в проём самой
	# комнаты — и это всё ещё читалось «он в детской»: проём у самой её стены,
	# а вход тут же затаскивал внутрь. Играющий так и сказал: спавнится в детской.
	#
	# Порог, с которого он пришёл, — УЛИЧНЫЙ, в дальнем конце коридора. Оттуда
	# он идёт по коридору сам, и к детской подходит уже зная, что за спиной у
	# него улица. Тогда и «я же только оттуда пришёл» перестаёт быть надписью.
	# НАЧИНАЕМ НА УЛИЦЕ, А НЕ НА ПОРОГЕ.
	#
	# Игрок появлялся в дверях дома, которого не видел снаружи, и фраза «я же
	# только оттуда пришёл» опиралась на слова, а не на то, что он помнит.
	# Теперь он идёт к дому сам: тринадцать метров по тротуару вдоль фонарей,
	# мимо машин под снегом, под снегопадом — и входит.
	#
	# Свободно гулять по улице всё равно нельзя, и это намеренно: там нечего
	# делать, а открытая улица, по которой можно уйти, отменяет саму завязку —
	# ты заперт под чужой детской. Подход огорожен, см. _invisible_wall.
	player.global_position = Vector3(-13.0, PlayerScript.STAND_Y, street_door_z + 1.8)
	# И rotation, и yaw: поворот игрока считается ОТ yaw, и без второй строки
	# камера разворачивалась на сто восемьдесят градусов в тот момент, когда
	# прологу возвращают управление.
	#
	# Смотрит ВДОЛЬ УЛИЦЫ, в сторону дома: yaw = −90° — это взгляд по +X, то
	# есть на фонари, машины под снегом и на тот подъезд, куда идти.
	player.rotation.y = -PI * 0.5
	player.yaw = -PI * 0.5
	# Чуть ниже горизонта: под ногами снег со следами, и первое, что должно
	# попасть в кадр, — что здесь зима и что здесь уже кто-то ходил.
	player.pitch = deg_to_rad(-4.0)
	# ШАГИ. В лабиринте их заводит world.gd, а пролог до него не доходит —
	# и до сих пор игрок ходил по снегу беззвучно.
	if player != null and player.has_signal("stepped"):
		player.stepped.connect(_on_step)
	player.set_physics_process(false)
	_build_ui()
	# Действия в проекте нигде не записаны — их заводит из кода world.gd, а
	# пролог до него ещё не дошёл. Без этой строки E в детской не работает.
	if not InputMap.has_action("fullscreen"):
		InputMap.add_action("fullscreen")
		var fev := InputEventKey.new()
		fev.physical_keycode = KEY_F11
		InputMap.action_add_event("fullscreen", fev)
	if not InputMap.has_action("read"):
		InputMap.add_action("read")
		var ev := InputEventKey.new()
		ev.physical_keycode = KEY_E
		InputMap.action_add_event("read", ev)
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


## ПРИЗМА — ЭТО КРЫША. Всё в этой сцене собрано из коробок, и потому дома вдали
## читались коробками: у дома силуэт решает всё, а плоская плита сверху — это
## силуэт склада. Треугольная призма даёт скат, и дом узнаётся с любого
## расстояния, даже когда стен уже не разобрать.
func _prism(size: Vector3, pos: Vector3, mat: Material, yaw: float = 0.0) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var pm := PrismMesh.new()
	pm.size = size
	mi.mesh = pm
	mi.material_override = mat
	mi.position = pos
	mi.rotation = Vector3(0.0, yaw, 0.0)
	add_child(mi)
	return mi


func _box(size: Vector3, pos: Vector3, mat: Material, solid: bool = true) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = size
	mi.mesh = bm
	mi.material_override = mat
	mi.position = pos
	add_child(mi)
	if solid:
		var body := StaticBody3D.new()
		var cs := CollisionShape3D.new()
		var sh := BoxShape3D.new()
		sh.size = size
		cs.shape = sh
		body.add_child(cs)
		body.position = pos
		add_child(body)
	return mi


## Кусок мебели внутри узла-родителя. То же, что _box, но без столкновений и
## с привязкой: силуэт под одеялом должен двигаться как одно целое.
func _part(parent: Node3D, size: Vector3, pos: Vector3, mat: Material) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = size
	mi.mesh = bm
	mi.material_override = mat
	mi.position = pos
	parent.add_child(mi)
	return mi


func _mat(c: Color, rough: float = 1.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = rough
	return m


func _tex(prefix: String, uv: float, tint: Color) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	var col = load("res://tex/%s_color.jpg" % prefix)
	if col == null:
		return _mat(tint)
	m.albedo_texture = col
	m.albedo_color = tint
	# ТРИПЛАНАР, А НЕ UV КОРОБКИ. Раньше каждая грань растягивала картинку на
	# себя целиком: половая доска шириной три метра, штукатурка размером со
	# стену — от этого комната и читалась собранной из деталей лего. Здесь uv —
	# это ПОВТОРОВ НА МЕТР, и доска остаётся доской на полу, на столе и на
	# обломке у пролома, какого бы размера кусок ни был.
	m.uv1_triplanar = true
	m.uv1_scale = Vector3(uv, uv, uv)
	m.roughness = 1.0
	# РЕЛЬЕФ И БЛЕСК — ОТДЕЛЬНЫМИ КАРТАМИ. Одна картинка цвета оставляет
	# поверхность гладкой пластмассой: свет по ней ложится ровно, и никакой
	# ткани или доски не читается. Нормаль даёт нити и волокна, шероховатость —
	# разницу между матовым одеялом и залакированным полом.
	#
	# СНАЧАЛА СПРОСИТЬ, ЕСТЬ ЛИ ФАЙЛ. load() от несуществующего пути — это не
	# null молча, а ошибка в консоль: обои детской и узор коридора я рисовал
	# сам, карт рельефа у них нет, и каждый запуск начинался с четырёх красных
	# строк, за которыми не видно настоящих.
	var npath: String = "res://tex/%s_normalgl.jpg" % prefix
	if ResourceLoader.exists(npath):
		m.normal_enabled = true
		m.normal_texture = load(npath)
		m.normal_scale = 1.0
	var rpath: String = "res://tex/%s_roughness.jpg" % prefix
	if ResourceLoader.exists(rpath):
		m.roughness_texture = load(rpath)
	m.metallic = 0.0
	return m


## ДЕТСКИЙ РИСУНОК КАРТИНКОЙ. Точки и линия между ними — ровно то, что игрок
## делает на полотнах. Рисуем в памяти: класть в проект три картинки ради трёх
## листов на стене нечестно, а фигуры всё равно берутся из общего списка.
func _draw_tex(idx: int) -> ImageTexture:
	var w: int = 220
	var h: int = 290
	var img := Image.create(w, h, false, Image.FORMAT_RGB8)
	var rng := RandomNumberGenerator.new()
	rng.seed = 1000 + idx
	for y in h:
		for x in w:
			var t: float = 0.92 + rng.randf() * 0.06
			img.set_pixel(x, y, Color(0.93 * t, 0.90 * t, 0.82 * t))
	var pts: Array = Shapes.TUTOR[idx % Shapes.TUTOR.size()]["pts"]
	var col: Color = [Color(0.22, 0.30, 0.55), Color(0.58, 0.24, 0.22),
		Color(0.24, 0.44, 0.26)][idx % 3]
	var scr: Array[Vector2] = []
	for p in pts:
		var v: Vector2 = p
		scr.append(Vector2(v.x * float(w) + rng.randf_range(-3.0, 3.0),
			v.y * float(h) + rng.randf_range(-3.0, 3.0)))
	for i in scr.size() - 1:
		var a: Vector2 = scr[i]
		var b: Vector2 = scr[i + 1]
		var n: int = int(a.distance_to(b)) + 1
		for k in n + 1:
			var q: Vector2 = a.lerp(b, float(k) / float(n))
			# Рука у ребёнка дрожит, линейки у него нет.
			q += Vector2(sin(float(k) * 0.42 + float(i)) * 1.4,
				cos(float(k) * 0.36 + float(i)) * 1.4)
			_blot(img, q, 1.7, col)
	for p2 in scr:
		_blot(img, p2, 3.1, col.darkened(0.35))
	return ImageTexture.create_from_image(img)


## Мягкая клякса карандаша.
func _blot(img: Image, at: Vector2, r: float, col: Color) -> void:
	var ri: int = int(ceil(r))
	for dy in range(-ri, ri + 1):
		for dx in range(-ri, ri + 1):
			var x: int = int(at.x) + dx
			var y: int = int(at.y) + dy
			if x < 0 or y < 0 or x >= img.get_width() or y >= img.get_height():
				continue
			var f: float = 1.0 - clampf(Vector2(dx, dy).length() / r, 0.0, 1.0)
			if f <= 0.0:
				continue
			img.set_pixel(x, y, img.get_pixel(x, y).lerp(col, f * 0.85))


func _build_room() -> void:
	# Пол — половая доска, стены — штукатурка. Обе карты CC0, источник записан
	# в tex/ИСТОЧНИК.txt.
	var floor_mat := _tex("floorwood", 0.55, Color(0.62, 0.52, 0.42))
	# ОБОИ, А НЕ ШТУКАТУРКА. Стены были ровные, белые и слегка шероховатые —
	# играющий назвал это прямо, и он прав: в комнате не за что зацепиться
	# глазу, и она читается коробкой, сколько её ни обставляй.
	#
	# Клетчатая ткань, которую я пробовал до этого, читалась плиткой уборной и
	# вдобавок рябила: мелкий регулярный узор на всю стену глаз не выдерживает.
	# Обои нарисованы отдельно (см. ОБОИ.md): синий фон, бледные рыбы в раппорте
	# со сдвигом, пузырьки. Масштаб 0.55 — повтор в 1.8 м, рыба сантиметров
	# двенадцать, как на настоящих детских обоях.
	var wall_mat := _tex("wallfish", 0.55, Color(1.0, 1.0, 1.0))
	floor_whole = _box(Vector3(W, 0.3, D), Vector3(0, -0.15, 0), floor_mat)
	# Тот же пол, но с вырезанным квадратом. Пока лежит невидимым поверх целого:
	# когда пол провалится, мы просто меняем один на другой — и в дыру ВИДНО,
	# а не просто чёрный квадрат нарисован на досках.
	floor_cut = Node3D.new()
	floor_cut.visible = false
	add_child(floor_cut)
	var hx: float = 0.0
	var hz: float = 0.4
	var hr: float = 0.85
	for piece in [
			[Vector3(W * 0.5 - hr, 0.3, D),
				Vector3((-W * 0.5 + hx - hr) * 0.5, -0.15, 0.0)],
			[Vector3(W * 0.5 - hr, 0.3, D), Vector3((W * 0.5 + hr) * 0.5, -0.15, 0.0)],
			[Vector3(hr * 2.0, 0.3, D * 0.5 - (hz + hr)),
				Vector3(hx, -0.15, (hz + hr + D * 0.5) * 0.5)],
			[Vector3(hr * 2.0, 0.3, (hz - hr) + D * 0.5),
				Vector3(hx, -0.15, ((hz - hr) - D * 0.5) * 0.5)]]:
		var pc := _part(floor_cut, piece[0], piece[1], floor_mat)
		pc.scale = Vector3.ONE
	# КОЛОДЕЦ БЕЗ ДНА. Было: стенки на 2.4 метра и донная плита на −2.5. Человек,
	# игравший впервые, описал это точно — «небольшая коробка внизу с полом»,
	# и добавил, что нет чувства, будто куда-то упал. Он и не падал: под ним
	# лежал пол в двух с половиной метрах.
	#
	# Теперь шахта уходит на двадцать четыре метра и дна у неё нет вовсе.
	# Смотреть туда — значит смотреть в темноту, у которой не видно конца:
	# стенки тают раньше, чем кончаются.
	var pit_mat := _mat(Color(0.05, 0.045, 0.045))
	var deep: float = 24.0
	for w in [[Vector3(hr * 2.0, deep, 0.06), Vector3(hx, -deep * 0.5, hz - hr)],
			[Vector3(hr * 2.0, deep, 0.06), Vector3(hx, -deep * 0.5, hz + hr)],
			[Vector3(0.06, deep, hr * 2.0), Vector3(hx - hr, -deep * 0.5, hz)],
			[Vector3(0.06, deep, hr * 2.0), Vector3(hx + hr, -deep * 0.5, hz)]]:
		_part(floor_cut, w[0], w[1], pit_mat)
	# РЁБРА, ИНАЧЕ ПАДЕНИЯ НЕ ВИДНО. Гладкие чёрные стенки в темноте неотличимы
	# друг от друга: игрок летит восемнадцать метров и всё это время смотрит в
	# ровное ничто — по кадру не понять, движется он или висит. Через каждые
	# полтора метра идёт кольцо посветлее с еле заметным свечением: света на
	# комнату оно не даёт, но проносится мимо, и падение становится падением.
	var rib_mat := _mat(Color(0.10, 0.09, 0.09))
	rib_mat.emission_enabled = true
	rib_mat.emission = Color(0.32, 0.30, 0.30)
	rib_mat.emission_energy_multiplier = 0.09
	# ПЕРВОЕ КОЛЬЦО — ГЛУБЖЕ. На высоте 1.2 м его достаёт лампа из комнаты, и
	# светлый прямоугольник в шахте читается дном коробки: «упасть некуда».
	var ry: float = -2.6
	while ry > -deep + 1.0:
		for r in [[Vector3(hr * 2.0, 0.10, 0.10), Vector3(hx, ry, hz - hr + 0.05)],
				[Vector3(hr * 2.0, 0.10, 0.10), Vector3(hx, ry, hz + hr - 0.05)],
				[Vector3(0.10, 0.10, hr * 2.0), Vector3(hx - hr + 0.05, ry, hz)],
				[Vector3(0.10, 0.10, hr * 2.0), Vector3(hx + hr - 0.05, ry, hz)]]:
			_part(floor_cut, r[0], r[1], rib_mat)
		ry -= 1.5
	# ЗАГЛУШКА НА САМОМ ДНЕ. Совсем без дна сквозь дальний конец шахты видно
	# фон сцены — светлый квадратик посреди черноты, и он выдавал всю глубину
	# разом. Крышка стоит в двадцати четырёх метрах, куда не достаёт ни лампа,
	# ни луна: на кадре она ровно такая же чернота, как стенки вокруг.
	_part(floor_cut, Vector3(hr * 2.0, 0.06, hr * 2.0),
		Vector3(hx, -deep, hz), pit_mat)
	_box(Vector3(W, 0.3, D), Vector3(0, H + 0.15, 0), _mat(Color(0.70, 0.69, 0.66)))
	# ЛЕВАЯ СТЕНА С НАСТОЯЩИМ ОКОННЫМ ПРОЁМОМ, а не сплошная.
	#
	# Окно трижды правилось цветом и всё равно оставалось плитой, налепленной на
	# стену, — потому что оно ею и было: стена сплошная, а стекло лежало поверх.
	# Играющий это видел с самого начала и называл верно: «из окна торчит та же
	# плита, только теперь синяя».
	#
	# Проём режется так же, как дверной: четыре куска вокруг дыры. Тогда у окна
	# появляются откосы — толщина стены по краям, — и стекло садится ВНУТРЬ.
	var ww: float = 1.50            ## ширина проёма окна (по Z)
	var wh: float = 1.10            ## высота
	var wcz: float = -0.4           ## середина по Z
	var wcy: float = 1.55           ## и по Y
	var lx: float = -W * 0.5 - 0.15
	# КАЖДЫЙ КУСОК СЧИТАЕТСЯ ОТ СВОИХ ГРАНИЦ, А НЕ ПО ОБЩЕЙ ФОРМУЛЕ. Здесь стояла
	# одна длина (D − ww)/2 на оба боковых куска — но проём сдвинут от середины
	# стены, и куски обязаны быть РАЗНОЙ длины. Из-за этого в стене зияли две
	# щели по двадцать сантиметров: 0.35–0.55 и 2.00–2.20. Играющий их и увидел.
	var z_lo: float = wcz - ww * 0.5        ## край проёма ближе к −Z
	var z_hi: float = wcz + ww * 0.5        ## и к +Z
	var a_len: float = z_lo + D * 0.5       ## кусок от стены до проёма
	var b_len: float = D * 0.5 - z_hi       ## и от проёма до стены
	for piece in [
			[Vector3(0.3, H, a_len), Vector3(lx, H * 0.5, -D * 0.5 + a_len * 0.5)],
			[Vector3(0.3, H, b_len), Vector3(lx, H * 0.5, z_hi + b_len * 0.5)],
			[Vector3(0.3, H - wcy - wh * 0.5, ww), Vector3(lx, (H + wcy + wh * 0.5) * 0.5, wcz)],
			[Vector3(0.3, wcy - wh * 0.5, ww), Vector3(lx, (wcy - wh * 0.5) * 0.5, wcz)]]:
		_box(piece[0], piece[1], wall_mat)
	_box(Vector3(0.3, H, D), Vector3(W * 0.5 + 0.15, H * 0.5, 0), wall_mat)
	_box(Vector3(W, H, 0.3), Vector3(0, H * 0.5, -D * 0.5 - 0.15), wall_mat)
	# СТЕНА С ДВЕРЬЮ, А НЕ СПЛОШНАЯ. Комната была закрытой коробкой: четыре
	# глухие плоскости, и «он вошёл» держалось на одном комментарии в коде.
	# Теперь в стене за спиной настоящий проём, и за ним видно улицу, откуда
	# он пришёл. Выйти нельзя — но не невидимой стеной, а его же отказом:
	# см. p_out и _try_leave.
	var dw: float = 1.15           ## ширина проёма
	var dh: float = 2.25           ## и высота
	var dx: float = 0.0            ## по центру стены
	for piece in [
			[Vector3((W - dw) * 0.5, H, 0.3), Vector3(-(W + dw) * 0.25, H * 0.5, D * 0.5 + 0.15)],
			[Vector3((W - dw) * 0.5, H, 0.3), Vector3((W + dw) * 0.25, H * 0.5, D * 0.5 + 0.15)],
			[Vector3(dw, H - dh, 0.3), Vector3(dx, dh + (H - dh) * 0.5, D * 0.5 + 0.15)]]:
		_box(piece[0], piece[1], wall_mat)
	door_x = dx
	door_w = dw
	# ПОРОГ ПОД ДВЕРЬЮ, И ОН НИЖЕ ПОЛОВ НА ТРИ МИЛЛИМЕТРА.
	#
	# Пол комнаты кончается на z = 2.20, пол коридора начинается на 2.50 — ровно
	# под проёмом тридцать сантиметров пустоты. Первая плита эту дыру закрыла,
	# но верх у неё был на нуле, как у обоих полов, и в местах перекрытия три
	# поверхности оказались НА ОДНОЙ ВЫСОТЕ. Совпадающие плоскости дрожат: чему
	# быть сверху, видеокарта решает по-разному от кадра к кадру. Починка
	# породила ровно ту же беду, которую чинила, только в другом месте.
	#
	# Три миллиметра вниз — и спорить не о чем: в перекрытии побеждает пол, а в
	# самой дыре плита единственная, и её ступеньку не разглядеть.
	_box(Vector3(dw + 0.5, 0.3, 0.42), Vector3(dx, -0.153, D * 0.5 + 0.15), floor_mat)
	_door_leaf(dx, D * 0.5 + 0.15, dw, dh, -1.0)
	_build_outside(dx, dw, dh)
	# ПЛИНТУС. Мелочь, но именно её отсутствие делает комнату коробкой: без него
	# стена втыкается в пол прямым швом, а такого шва в жилой комнате нет.
	var base_mat := _tex("furniture", 1.4, Color(0.66, 0.60, 0.54))
	for b in [[Vector3(W, 0.12, 0.04), Vector3(0, 0.06, -D * 0.5 + 0.02)],
			# Плинтус у двери РАЗОРВАН: цельная планка шла прямо через проём,
			# лёжа поперёк порога белой полоской.
			[Vector3((W - dw) * 0.5 - 0.1, 0.12, 0.04),
				Vector3(-(W + dw) * 0.25 - 0.05, 0.06, D * 0.5 - 0.02)],
			[Vector3((W - dw) * 0.5 - 0.1, 0.12, 0.04),
				Vector3((W + dw) * 0.25 + 0.05, 0.06, D * 0.5 - 0.02)],
			[Vector3(0.04, 0.12, D), Vector3(-W * 0.5 + 0.02, 0.06, 0)],
			[Vector3(0.04, 0.12, D), Vector3(W * 0.5 - 0.02, 0.06, 0)]]:
		_box(b[0], b[1], base_mat, false)
	# ОКНО СИДИТ В ПРОЁМЕ. Проём прорезан выше; здесь остаётся только стекло,
	# переплёт и подоконник. Стекло стоит у ДАЛЬНЕЙ грани стены — снаружи, как и
	# положено, — а между ним и комнатой остаются двадцать сантиметров откоса.
	# Именно этот откос и делает окно окном: у плиты, налепленной на стену, его
	# нет, и никакой цвет этого не заменит.
	var face: float = -W * 0.5          ## внутренняя поверхность стены
	var outer: float = -W * 0.5 - 0.30  ## наружная
	var gy: float = 1.55
	var gz: float = -0.4
	# СТЕКЛО ЗАКРЫВАЕТ ПРОЁМ ЦЕЛИКОМ. Оно было на пару сантиметров меньше дыры,
	# и по краям оставались щели: с улицы, под острым углом, сквозь них была
	# видна комната изнутри — обои с рыбами снаружи дома.
	#
	# И слабо светится: в комнате горит лампа, а окно с улицы было чёрным, как
	# у нежилого дома. Одно тёплое окно — то, ради чего к дому и идёшь.
	var pane := _mat(Color(0.07, 0.08, 0.11))
	pane.emission_enabled = true
	pane.emission = Color(1.0, 0.80, 0.52)
	pane.emission_energy_multiplier = 0.42
	var glass := _box(Vector3(0.04, 1.14, 1.54),
		Vector3(outer + 0.06, gy, gz), pane, false)
	# СТЕКЛО НЕ ДЕРЖИТ СВЕТ. Оно непрозрачное для рендера и потому отбрасывало
	# тень на всю комнату: луна светила в окно и упиралась в него же. Отключаем
	# отбрасывание — и на полу наконец появляется переплёт.
	glass.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var frame_mat := _mat(Color(0.30, 0.27, 0.24))
	# Переплёт — ПЕРЕД стеклом, в глубине проёма: вертикаль и горизонталь.
	_box(Vector3(0.05, 1.08, 0.045), Vector3(outer + 0.11, gy, gz), frame_mat, false)
	_box(Vector3(0.05, 0.045, 1.48), Vector3(outer + 0.11, gy, gz), frame_mat, false)
	# Подоконник — по нижнему откосу, с небольшим выносом в комнату.
	_box(Vector3(0.40, 0.04, 1.56), Vector3(face - 0.13, gy - 0.56, gz),
		_mat(Color(0.38, 0.35, 0.31)), false)
	var gm := glass.material_override as StandardMaterial3D
	# Стекло почти чёрное и почти матовое: ночью в нём не видно ничего, кроме
	# слабого отблеска. Свет в комнату даёт отдельная лампа-«луна» у окна.
	gm.emission_enabled = true
	gm.emission = Color(0.24, 0.31, 0.50)
	gm.emission_energy_multiplier = 0.08
	gm.roughness = 0.30
	gm.metallic = 0.10
	gm.metallic_specular = 0.45
	# НОЧЬ, А НЕ ДЕНЬ — И ЭТО ТРЕБОВАНИЕ САМОЙ ИГРЫ, НЕ ВКУС.
	#
	# Первая надпись пролога: «ЭТО НЕ ТВОЯ КОМНАТА. E — ЛАМПА.» Игра просит
	# включить свет. А свет уже горел: окно на 2.2 плюс заливка на 0.8 давали
	# среднюю по кадру 123 из 255 — ярче, чем нужно, чтобы всё разглядеть.
	# Лампа при этом не меняла ничего: нажатие, щелчок и никакой разницы.
	# Взаимодействие, которое игра ставит первым, было мёртвым.
	#
	# Теперь из окна светит луна — холодно и слабо, ровно чтобы найти дорогу к
	# лампе и увидеть, что в кровати кто-то лежит. Всё остальное приносит лампа.
	var day := OmniLight3D.new()
	day.light_color = Color(0.58, 0.68, 0.92)
	# 0.12: эта лампа была «луной» до того, как появилась настоящая. Теперь она
	# лишь смягчает откосы у самого окна, а свет в комнату льёт направленная.
	day.light_energy = 0.12
	day.omni_range = 8.0
	day.position = Vector3(-W * 0.5 + 0.6, 1.6, -0.4)
	add_child(day)
	var fill := OmniLight3D.new()
	fill.light_color = Color(0.62, 0.68, 0.80)
	fill.light_energy = 0.16
	fill.omni_range = 9.0
	fill.position = Vector3(0, H - 0.4, 0)
	add_child(fill)


## УЛИЦА ЗА ДВЕРЬЮ. Не нарисованный задник: короткий тамбур с полом и стенами,
## а дальше туман и холодный свет фонаря. Глубины хватает, чтобы глаз поверил,
## что там продолжается мир, и не хватает, чтобы разглядывать — а разглядывать
## там нечего, и это честно: игра не про улицу.
##
## Почему вообще: комната была коробкой из четырёх глухих стен, и это первое,
## что видит человек. Коробка читается декорацией, сколько её ни освещай.
func _build_outside(dx: float, dw: float, dh: float) -> void:
	# КОРИДОР, ДВЕРЬ, УЛИЦА — ТРИ РАЗНЫЕ ВЕЩИ, а не одна труба.
	#
	# Раньше здесь был просто длинный проход, уходящий в темноту, и играющий
	# сказал верно: «в проёме просто коридор». Коридор сам по себе ничего не
	# объясняет — он такая же коробка, только вытянутая. Нужна СТУПЕНЧАТОСТЬ:
	# из детской видно коридор, в коридоре видно дверь, за дверью видно улицу.
	# Каждый шаг обещает следующий, и поэтому мир кажется больше, чем построен.
	var z0: float = D * 0.5 + 0.3
	var hall_w: float = dw + 1.5
	var hall: float = 7.0              ## длина коридора до уличной двери
	# КОРИДОР ЧЁРНЫЙ И С УЗОРОМ. Светлая штукатурка делала его продолжением
	# детской, а он должен быть другим местом: детская — то, что помнят, коридор
	# — то, через что идут. Узор нарочно на грани различимости.
	# Тон приглушён: под тёплым фонарём стены читались коричневыми, а нужны
	# чёрные. Свет оставляем тёплым — на нём держится контраст с холодной улицей.
	var wall_mat := _tex("hallpat", 0.8, Color(0.62, 0.60, 0.62))
	var floor_mat := _tex("floorwood", 0.55, Color(0.34, 0.28, 0.23))
	_box(Vector3(hall_w, 0.2, hall), Vector3(dx, -0.1, z0 + hall * 0.5), floor_mat)
	_box(Vector3(hall_w, 0.2, hall), Vector3(dx, H + 0.1, z0 + hall * 0.5), wall_mat)
	_box(Vector3(0.2, H, hall), Vector3(dx - hall_w * 0.5, H * 0.5, z0 + hall * 0.5), wall_mat)
	_box(Vector3(0.2, H, hall), Vector3(dx + hall_w * 0.5, H * 0.5, z0 + hall * 0.5), wall_mat)
	# УЛИЧНАЯ ДВЕРЬ в торце коридора: та же выкройка, что у двери детской.
	var ow: float = 1.25
	var oh: float = 2.35
	var zt: float = z0 + hall
	for piece in [
			[Vector3((hall_w - ow) * 0.5, H, 0.2), Vector3(dx - (hall_w + ow) * 0.25, H * 0.5, zt)],
			[Vector3((hall_w - ow) * 0.5, H, 0.2), Vector3(dx + (hall_w + ow) * 0.25, H * 0.5, zt)],
			[Vector3(ow, H - oh, 0.2), Vector3(dx, oh + (H - oh) * 0.5, zt)]]:
		# СО СТОЛКНОВЕНИЯМИ. Здесь стояло false, и стена с уличной дверью была
		# насквозь проходимой: преграда закрывала только сам проём, а рядом с
		# ним игрок спокойно выходил сквозь штукатурку. Играющий это и нашёл —
		# «можно свободно выйти, если пройти чуть сбоку».
		_box(piece[0], piece[1], wall_mat)
	street_door_z = zt
	_house_skin(dx, z0, hall, hall_w, zt, ow, oh)
	street_leaf = _door_leaf(dx, zt, ow, oh, 1.0)
	street_hinge = deg_to_rad(78.0)
	_build_street(dx, zt, hall_w)
	# Фонарь в коридоре — тёплый и тусклый, чтобы улица за дверью читалась
	# ХОЛОДНОЙ по сравнению. Один контраст рассказывает больше, чем две лампы.
	var hl := OmniLight3D.new()
	hl.light_color = Color(0.96, 0.82, 0.62)
	# ЯРЧЕ, ЧЕМ КАЖЕТСЯ НУЖНЫМ. Стены коридора почти чёрные (альбедо 0.055) и
	# съедают свет почти целиком: при 2.4 узора на них не было видно вовсе, то
	# есть он существовал только в файле. Тёмные стены требуют БОЛЬШЕ света, а
	# не меньше, — иначе они не тёмные, а пустые.
	hl.light_energy = 4.6
	hl.omni_range = 7.5
	hl.shadow_enabled = false
	hl.position = Vector3(dx, 2.5, z0 + 1.8)
	add_child(hl)
	var hl2 := OmniLight3D.new()
	hl2.light_color = Color(0.92, 0.78, 0.60)
	hl2.light_energy = 2.6
	hl2.omni_range = 6.5
	hl2.shadow_enabled = false
	hl2.position = Vector3(dx, 2.5, z0 + 5.0)
	add_child(hl2)
	_hall_stuff(dx, z0, hall, hall_w)
	# ПРЕГРАДА В УЛИЧНОМ ПРОЁМЕ — СНАЧАЛА ВЫКЛЮЧЕНА. Игра начинается на улице, и
	# при включённой преграде игрок просто не мог войти в дом: упирался в
	# невидимое за тридцать сантиметров до порога.
	#
	# Она включается в тот миг, когда он переступил порог, — и дверь за ним
	# захлопывается. Так закрытая дверь становится СОБЫТИЕМ, а не декорацией,
	# которую он обнаружит, когда захочет уйти.
	var stop := StaticBody3D.new()
	var cs := CollisionShape3D.new()
	var sh := BoxShape3D.new()
	sh.size = Vector3(ow, oh, 0.3)
	cs.shape = sh
	cs.disabled = true
	stop.add_child(cs)
	stop.position = Vector3(dx, oh * 0.5, zt + 0.16)
	add_child(stop)
	street_stop = cs
	door_pos = Vector3(dx, 1.0, zt - 0.3)


## УЛИЦА. Не комната и не труба: у неё нет потолка, пол другой, дальняя стена
## далеко и это ФАСАД, а не торец. Игрок туда не попадёт — но увидеть должен
## именно улицу, иначе дверь не имеет смысла.
## ДВЕРЬ: КОРОБКА И РАСПАХНУТОЕ ПОЛОТНО. Проём без двери — это дыра в стене, и
## жилой дом так не выглядит: играющий спросил прямо, где двери.
##
## Полотно стоит ОТКРЫТЫМ и отведено почти к стене — закрывать его нечем и
## незачем, а открытая дверь сама объясняет, что сюда только что вошли.
## Собирается внутрь узла-поворота, чтобы вращаться ОТ ПЕТЕЛЬ, а не от середины.
##
## hinge — с какой стороны проёма петли (−1 слева по X, +1 справа).
func _door_leaf(cx: float, cz: float, w: float, h: float, hinge: float) -> Node3D:
	var wood := _tex("wood", 1.1, Color(0.40, 0.31, 0.24))
	var dark := _mat(Color(0.20, 0.17, 0.15))
	var brass := _mat(Color(0.52, 0.42, 0.20), 0.35)
	var th: float = 0.05
	# КОРОБКА: стойки по краям проёма и притолока. Без неё полотно висит в дыре.
	# ГРАНИ НЕ ДОЛЖНЫ СОВПАДАТЬ С КРАЕМ ПРОЁМА. Стойки стояли так, что их
	# внутренняя грань ложилась ровно на кромку стены, а две совпадающие
	# плоскости — это мерцание: видеокарте нечем решить, какая ближе. Играющий
	# увидел его как «дёргается крепление дверей».
	#
	# Настоящий наличник и не совпадает: он НАКРЫВАЕТ кромку. Заводим стойки на
	# два с половиной сантиметра внутрь проёма, притолоку — вниз.
	for sgn in [-1.0, 1.0]:
		_box(Vector3(0.09, h, 0.13), Vector3(cx + sgn * (w * 0.5 + 0.02), h * 0.5, cz),
			dark, false)
	_box(Vector3(w + 0.18, 0.09, 0.13), Vector3(cx, h - 0.02, cz), dark, false)
	# Узел-поворот стоит на петлях.
	var pivot := Node3D.new()
	pivot.position = Vector3(cx + w * 0.5 * hinge, 0.0, cz)
	add_child(pivot)
	# 78°, а не 90: распахнутая настежь дверь читается декорацией, а
	# приоткрытая почти до упора выглядит так, как её оставили.
	pivot.rotation.y = deg_to_rad(78.0) * hinge
	var lw: float = w - 0.03
	var lh: float = h - 0.06
	# Полотно: от петли в сторону проёма.
	_part(pivot, Vector3(lw, lh, th), Vector3(-lw * 0.5 * hinge, lh * 0.5 + 0.03, 0.0), wood)
	# Филёнки — две утопленные рамки; гладкая доска читается фанерой.
	for k in [-1.0, 1.0]:
		# Вынос 0.012 при полотне в 0.05: рамка заметно выступает за грань и
		# потому не спорит с ней. Раньше она кончалась почти вровень.
		_part(pivot, Vector3(lw * 0.6, lh * 0.28, th * 0.6),
			Vector3(-lw * 0.5 * hinge, lh * (0.5 + k * 0.23) + 0.03, th * 0.5 + 0.012), dark)
		_part(pivot, Vector3(lw * 0.6, lh * 0.28, th * 0.6),
			Vector3(-lw * 0.5 * hinge, lh * (0.5 + k * 0.23) + 0.03, -th * 0.5 - 0.012), dark)
	# Ручка — у края, противоположного петлям, с обеих сторон полотна.
	for zs in [-1.0, 1.0]:
		_part(pivot, Vector3(0.11, 0.05, 0.05),
			Vector3(-lw * 0.86 * hinge, h * 0.47, zs * (th * 0.5 + 0.03)), brass)
	return pivot


## ОБСТАНОВКА КОРИДОРА: лампа под потолком, часы и картины. Пустой коридор с
## двумя лампочками читается служебным проходом, а это ЖИЛОЙ дом — и разницу
## делают именно такие мелочи, которые никто не разглядывает поимённо.
func _hall_stuff(dx: float, z0: float, hall: float, hall_w: float) -> void:
	var brass := _mat(Color(0.42, 0.34, 0.18), 0.45)
	var dark := _mat(Color(0.14, 0.13, 0.13))
	var glassy := _mat(Color(0.95, 0.92, 0.84))
	glassy.emission_enabled = true
	glassy.emission = Color(1.0, 0.90, 0.70)
	glassy.emission_energy_multiplier = 1.6
	# ЛАМПА: чашка под потолком на короткой ножке. Свет от неё уже стоит рядом
	# (см. hl), здесь — само тело, чтобы источник было ВИДНО.
	for zl in [z0 + 1.8, z0 + 5.0]:
		_box(Vector3(0.05, 0.28, 0.05), Vector3(dx, H - 0.14, zl), brass, false)
		var cup := _box(Vector3(0.44, 0.16, 0.44), Vector3(dx, H - 0.34, zl), glassy, false)
		cup.rotation_degrees = Vector3(0, 45.0, 0)
	# ЧАСЫ на правой стене: круглый корпус, циферблат и две стрелки.
	var cz: float = z0 + 3.1
	var cxw: float = dx + hall_w * 0.5 - 0.12
	var body := MeshInstance3D.new()
	var cm := CylinderMesh.new()
	cm.top_radius = 0.135
	cm.bottom_radius = 0.135
	cm.height = 0.07
	cm.radial_segments = 24
	body.mesh = cm
	body.material_override = dark
	body.position = Vector3(cxw, 1.95, cz)
	body.rotation_degrees = Vector3(0, 0, 90.0)
	add_child(body)
	var face := MeshInstance3D.new()
	var fm := CylinderMesh.new()
	fm.top_radius = 0.115
	fm.bottom_radius = 0.115
	fm.height = 0.02
	fm.radial_segments = 24
	face.mesh = fm
	# Циферблат приглушён: при 0.88 он ловил свет лампы и читался светящимся
	# блюдцем во всю стену. Часы в коридоре — мелочь, а не источник света.
	face.material_override = _mat(Color(0.62, 0.60, 0.55))
	face.position = Vector3(cxw - 0.05, 1.95, cz)
	face.rotation_degrees = Vector3(0, 0, 90.0)
	add_child(face)
	# Стрелки: часовая коротко вверх-влево, минутная длинно вниз — время
	# намеренно «около двух», а не двенадцать: ровно двенадцать читается
	# нарисованным значком часов, а не часами.
	for hand in [[0.052, 0.014, -38.0], [0.088, 0.010, 115.0]]:
		var h := _box(Vector3(0.012, float(hand[0]) * 2.0, float(hand[1])),
			Vector3(cxw - 0.07, 1.95, cz), dark, false)
		var ang: float = deg_to_rad(float(hand[2]))
		h.position += Vector3(0, cos(ang) * float(hand[0]), sin(ang) * float(hand[0]))
		h.rotation_degrees = Vector3(float(hand[2]), 0, 0)
	# КАРТИНЫ на левой стене: рама, паспарту и тёмный холст. Что на них — не
	# важно и намеренно не разобрать: в чужом коридоре картины именно такие.
	var fx: float = dx - hall_w * 0.5 + 0.12
	var i: int = 0
	for spec in [[z0 + 2.2, 0.62, 0.48], [z0 + 4.4, 0.46, 0.58]]:
		var pz: float = float(spec[0])
		var pw: float = float(spec[1])
		var ph2: float = float(spec[2])
		# СЛОИ ИДУТ ОТ СТЕНЫ В КОРИДОР, а не вглубь неё. Здесь они шли внутрь, и
		# из коридора была видна только изнанка рамы — коричневая доска. Рама у
		# стены, паспарту перед ней, холст впереди всех и меньше всех.
		_box(Vector3(0.05, ph2 + 0.09, pw + 0.09), Vector3(fx, 1.85, pz),
			_mat(Color(0.33, 0.24, 0.15), 0.6), false)
		_box(Vector3(0.03, ph2, pw), Vector3(fx + 0.03, 1.85, pz),
			_mat(Color(0.80, 0.77, 0.70)), false)
		_box(Vector3(0.02, ph2 - 0.14, pw - 0.14), Vector3(fx + 0.05, 1.85, pz),
			_mat(Color(0.18, 0.20, 0.17) if i == 0 else Color(0.22, 0.17, 0.16)), false)
		i += 1


## УЛИЦА. Не коробка чуть больше нашего дома, а место, у которого есть небо,
## глубина и стороны. Играющий описал прежнюю точно: «дом — просто стена с
## окнами, улица — куб, неба нет». Всё три перечисленных здесь и чинится.
##
## Устройство: мостовая уходит ВЛЕВО И ВПРАВО за края видимого, дома стоят
## двумя рядами на разной глубине и разной высоты, между ними просветы, над
## всем — настоящее звёздное небо и луна, которую видно из окна детской.
## Зима: снег на земле, сугробы вдоль стен, шапки на карнизах и снегопад.
func _build_street(dx: float, zt: float, hall_w: float) -> void:
	var z1: float = zt + 0.3
	_street_sky()
	_street_ground(dx, z1, hall_w)
	_street_houses(dx, z1)
	_street_lamps(dx, z1)
	_street_cars(dx, z1)
	_street_snowfall(dx, z1)


## НЕБО И ЛУНА. Без среды сцена рисует плоский цвет — отсюда и «неба нет».
func _street_sky() -> void:
	var we := WorldEnvironment.new()
	var env := Environment.new()
	var sky := Sky.new()
	var pano := PanoramaSkyMaterial.new()
	var tex = load("res://tex/sky/night_2k.hdr")
	if tex != null:
		pano.panorama = tex
	# Небо само по себе яркое не нужно: звёзды должны читаться, а не светить.
	pano.energy_multiplier = 0.85
	sky.sky_material = pano
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	# СВЕТ ОТ НЕБА — СЛАБЫЙ И ХОЛОДНЫЙ. На полной силе звёздное небо заливает
	# комнату синим, и ночь перестаёт быть ночью: лампа над столом обязана
	# оставаться главным источником в детской.
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_sky_contribution = 1.0
	# 0.12, А НЕ 0.22. Заливка от неба ровно освещает ВСЮ комнату, и полоса от
	# луны в ней тонет: светлое должно быть там, куда луна достаёт, и только там.
	env.ambient_light_energy = 0.12
	# Туман — не украшение: он отделяет дальние дома от ближних и не даёт улице
	# читаться нарисованной задником.
	env.fog_enabled = true
	env.fog_light_color = Color(0.42, 0.50, 0.68)
	env.fog_light_energy = 0.6
	env.fog_density = 0.012
	env.fog_sky_affect = 0.25
	# ОБЪЁМНЫЙ ТУМАН ВЫКЛЮЧЕН. Он общий на всю сцену, а не только на улицу, и
	# потому висел ПАРОМ В КОРИДОРЕ — играющий так и сказал. Дать его наружу и
	# не дать внутрь нельзя: среда одна на всё.
	#
	# Глубинный туман остаётся: он работает от расстояния, а в коридоре семь
	# метров — это восемь процентов плотности, то есть ничего. Улицу он
	# отделяет по слоям, комнату не трогает.
	env.volumetric_fog_enabled = false
	we.environment = env
	add_child(we)
	# ЛУНА — И СВЕТ, И ДИСК. Свет направленный, потому что только он даёт
	# честную полосу на полу детской: окно должно рисовать на досках свой
	# переплёт, и это самое дорогое, что тут есть.
	var moon := DirectionalLight3D.new()
	moon.light_color = Color(0.74, 0.82, 1.0)
	moon.light_energy = 2.8
	moon.shadow_enabled = true
	# 34, А НЕ 60. Карта теней одна на всю дальность: растянутая на шестьдесят
	# метров улицы, вблизи она давала ступенчатое пятно на стене у самой двери —
	# то есть ровно там, куда игрок смотрит в первые секунды игры.
	moon.directional_shadow_max_distance = 34.0
	moon.directional_shadow_blend_splits = true
	moon.light_angular_distance = 0.6
	# Направление выбрано так, чтобы луч шёл В ОКНО детской (окно в стене −X,
	# смотрит наружу влево) и ложился на пол наискось.
	# ЗНАК ВАЖЕН. При +62° луч шёл ИЗ комнаты наружу, и на полу не появлялось
	# ничего: окно в стене −X, значит свет обязан лететь в сторону +X, то есть
	# поворот отрицательный. Проверяется одним взглядом на пол под окном.
	# И НИЖЕ НАД ГОРИЗОНТОМ. При −34° луч падал круто и ложился у самой стены
	# узкой полоской. Луна низкая бросает свет ВГЛУБЬ комнаты, через полпола, и
	# переплёт окна успевает нарисоваться на досках целиком.
	# УГОЛ ПОСЧИТАН, А НЕ ПОДОБРАН. При (−19, −62) луч уходил вбок так сильно,
	# что от окна на высоте 1.55 до пола ему оставалось 4.7 м по горизонтали —
	# и пятно ложилось на ДАЛЬНЮЮ СТЕНУ, за краем комнаты. Я трижды смотрел на
	# пол и трижды ничего не находил, хотя свет исправно шёл.
	#
	# (−26, −85): луч почти поперёк стены, спуск 0.44 на единицу пути. От центра
	# окна до пола 3.5 м по лучу, 3.2 по горизонтали — пятно садится примерно в
	# (0.6, −0.7), то есть посреди комнаты, где его и должно быть видно.
	moon.rotation_degrees = Vector3(-26.0, -85.0, 0.0)
	add_child(moon)
	moon_node = moon
	# Сам диск: далеко, сам себе светится, тенями не занимается.
	var disc := MeshInstance3D.new()
	var sm := SphereMesh.new()
	sm.radius = 3.4
	sm.height = 6.8
	disc.mesh = sm
	var mm := StandardMaterial3D.new()
	mm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mm.albedo_color = Color(0.94, 0.96, 1.0)
	disc.mesh.material = mm
	disc.position = -moon.global_transform.basis.z * -120.0 + Vector3(0, 40.0, 0)
	add_child(disc)


## ОБШИВКА НАШЕГО ДОМА СНАРУЖИ. Стены детской и коридора — это одни и те же
## коробки с обеих сторон, и с улицы было видно ОБОИ С РЫБАМИ: синяя детская
## комната стояла посреди зимнего квартала как декорация без задней стенки.
##
## Штукатурка кладётся тонкими плитами поверх наружных граней — в сантиметре
## от них, чтобы не спорить с ними за глубину. Плюс крыша со снегом: без неё
## дом остаётся коробкой с плоским верхом, а такого дома в квартале нет.
func _house_skin(dx: float, z0: float, hall: float, hall_w: float, zt: float,
		ow: float, oh: float) -> void:
	var skin := _tex("plaster", 0.7, Color(0.37, 0.35, 0.34))
	var snow := _mat(Color(0.86, 0.90, 0.96), 0.9)
	var cor := _mat(Color(0.24, 0.23, 0.23))
	var t: float = 0.03
	# ДЕТСКАЯ. Наружные грани: −X (с окном), +X и −Z. Грань +Z смотрит в
	# коридор, она внутренняя.
	var ox: float = W * 0.5 + 0.3 + 0.01      ## наружная поверхность боковой стены
	var oz: float = D * 0.5 + 0.3 + 0.01      ## и задней
	# Окно повторяем ТЕМИ ЖЕ числами, что и в стене: расходись они хоть на
	# сантиметр — и в проёме появится белая рамка поверх откоса.
	var ww: float = 1.50
	var wh: float = 1.10
	var wcz: float = -0.4
	var wcy: float = 1.55
	var z_lo: float = wcz - ww * 0.5
	var z_hi: float = wcz + ww * 0.5
	var a_len: float = z_lo + D * 0.5
	var b_len: float = D * 0.5 - z_hi
	# ВЫШЕ СТЕН НА ПОЛМЕТРА. Плита перекрытия лежит с трёх до трёх и трёх, и её
	# торец торчал наружу бежевой полосой по всему периметру дома — ровно там,
	# где у настоящего дома фриз под карнизом.
	var sh: float = H + 0.45
	for piece in [
			[Vector3(t, sh, a_len), Vector3(-ox, sh * 0.5, -D * 0.5 + a_len * 0.5)],
			[Vector3(t, sh, b_len), Vector3(-ox, sh * 0.5, z_hi + b_len * 0.5)],
			[Vector3(t, sh - wcy - wh * 0.5, ww), Vector3(-ox, (sh + wcy + wh * 0.5) * 0.5, wcz)],
			[Vector3(t, wcy - wh * 0.5, ww), Vector3(-ox, (wcy - wh * 0.5) * 0.5, wcz)]]:
		_box(piece[0], piece[1], skin, false)
	# С ЗАПАСОМ. Плиты сходятся на углах, и на стыке в полсантиметра с улицы
	# опять проглядывали обои. Перехлёст ничего не стоит: плиты тонкие и лежат
	# под прямым углом друг к другу, лишнее уходит внутрь соседней.
	_box(Vector3(t, sh, D + 1.4), Vector3(ox, sh * 0.5, 0), skin, false)
	_box(Vector3(W + 1.4, sh, t), Vector3(0, sh * 0.5, -oz), skin, false)
	# И ГРАНЬ +Z, ТА, ЧТО СМОТРИТ К УЛИЦЕ. Её я счёл внутренней — мол, за ней
	# коридор. Но коридор вдвое уже детской: он закрывает лишь середину, а по
	# краям стена с дверью детской выходит НА УЛИЦУ, и с тротуара были видны
	# обои с рыбами. Именно их играющий и увидел бы первым делом.
	var hxx: float = hall_w * 0.5 + 0.1 + 0.01
	var wing: float = W * 0.5 + 0.9 - hxx
	for sx in [-1.0, 1.0]:
		_box(Vector3(wing, sh, t), Vector3(sx * (hxx + wing * 0.5), sh * 0.5, oz),
			skin, false)
	# КОРИДОР — своей ширины, он уже детской и выступает к улице отдельным крылом.
	for sx in [-1.0, 1.0]:
		_box(Vector3(t, sh, hall + 0.6), Vector3(dx + sx * hxx, sh * 0.5, z0 + hall * 0.5),
			skin, false)
	# ФАСАД вокруг уличной двери — той же штукатуркой: изнутри там чёрный узор
	# коридора, и снаружи он читался закопчённой стеной.
	for piece in [
			[Vector3((hall_w - ow) * 0.5, sh, t), Vector3(dx - (hall_w + ow) * 0.25, sh * 0.5, zt + 0.11)],
			[Vector3((hall_w - ow) * 0.5, sh, t), Vector3(dx + (hall_w + ow) * 0.25, sh * 0.5, zt + 0.11)],
			[Vector3(ow, sh - oh, t), Vector3(dx, oh + (sh - oh) * 0.5, zt + 0.11)]]:
		_box(piece[0], piece[1], skin, false)
	# КРЫШ ЗДЕСЬ БОЛЬШЕ НЕТ: и над детской, и над коридором теперь стоит второй
	# этаж, а крыша у дома одна и лежит поверх него — см. _house_big.
	# Остаётся только КОЗЫРЁК над самой дверью: без него дверь — дыра в стене.
	_box(Vector3(ow + 1.1, 0.12, 0.9), Vector3(dx, oh + 0.62, zt + 0.42), cor, false)
	_box(Vector3(ow + 0.9, 0.16, 0.7), Vector3(dx, oh + 0.74, zt + 0.38), snow, false)
	_house_big(dx, sh, zt, ow, oh, skin, snow, cor)
	# ЛАМПОЧКА НАД ДВЕРЬЮ. Единственный тёплый огонёк на фасаде: по нему дверь
	# и находишь, подходя по тёмной улице.
	var bulb := _mat(Color(0.98, 0.88, 0.66))
	bulb.emission_enabled = true
	bulb.emission = Color(1.0, 0.86, 0.60)
	bulb.emission_energy_multiplier = 2.4
	_box(Vector3(0.22, 0.16, 0.14), Vector3(dx, oh + 0.34, zt + 0.2), bulb, false)
	# НОМЕР ДОМА и КОВРИК. Две мелочи у самой двери — там, где игрок стоит
	# дольше всего за всю улицу. Голая штукатурка рядом с дверью читается
	# служебным входом, а сюда человек приходит домой.
	var plate := _mat(Color(0.14, 0.14, 0.16), 0.5)
	_box(Vector3(0.26, 0.34, 0.03), Vector3(dx - ow * 0.5 - 0.42, 1.62, zt + 0.13),
		plate, false)
	var digit := _mat(Color(0.86, 0.84, 0.78))
	digit.emission_enabled = true
	digit.emission = Color(0.9, 0.86, 0.74)
	digit.emission_energy_multiplier = 0.5
	# «11» — две палочки: цифры рисовать нечем, а две планки читаются номером.
	for k in [-1.0, 1.0]:
		_box(Vector3(0.035, 0.2, 0.02),
			Vector3(dx - ow * 0.5 - 0.42 + k * 0.05, 1.62, zt + 0.15), digit, false)
	# Коврик: вытоптанный снег на нём не лежит, поэтому он тёмный.
	_box(Vector3(0.9, 0.04, 0.55), Vector3(dx, 0.045, zt + 0.5),
		_mat(Color(0.17, 0.15, 0.13), 0.95), false)
	var pl := OmniLight3D.new()
	pl.light_color = Color(1.0, 0.88, 0.66)
	pl.light_energy = 3.2
	pl.omni_range = 5.5
	pl.shadow_enabled = false
	pl.position = Vector3(dx, oh + 0.28, zt + 0.35)
	add_child(pl)


## ДОМ ЦЕЛИКОМ, А НЕ БУДКА С КОРИДОРОМ.
##
## Изнутри дом — это детская и коридор к двери, и всё. Снаружи так и читалось:
## низкая коробочка с приделанным к ней рукавом, между тем как соседи —
## настоящие дома в три-четыре этажа. Играющий сказал прямо: «это не дом, а
## будка с коридором и только детской».
##
## Комнат мы не строим: внутрь их всё равно не пустят, а фальшивая дверь, за
## которой ничего нет, — обман хуже пустоты. Строим ОБЪЁМ: дом шире и глубже
## своих двух комнат, у него есть второй этаж и окна, за которыми кто-то жил.
## Ходить там нельзя — но и незачем: игрок идёт мимо, в свою дверь.
##
## Расти дом может только ВПРАВО и НАЗАД. Влево нельзя: в левой стене детской
## окно, и оно обязано выходить на улицу, а не в чужую комнату, — на нём висит
## полоса лунного света на полу, самое дорогое, что есть в прологе.
func _house_big(dx: float, sh: float, zt: float, ow: float, oh: float,
		skin: StandardMaterial3D, snow: StandardMaterial3D,
		cor: StandardMaterial3D) -> void:
	var lx: float = -W * 0.5 - 0.33     ## левая грань дома: стена детской с окном
	var rx: float = 8.0                 ## правая: туда дом и вырос
	var zb: float = -D * 0.5 - 3.4      ## задняя стена
	var zf: float = zt + 0.14           ## лицо дома вровень с уличной дверью
	var up: float = 3.55                ## где начинается второй этаж
	var top: float = 7.1                ## и где он кончается
	var t: float = 0.05
	# ПЕРВЫЙ ЭТАЖ — только наружные поверхности. Сплошной коробкой его делать
	# нельзя: внутри стоят детская и коридор, и коробка накрыла бы их собой.
	for piece in [
			# правая стена
			[Vector3(t, sh, zf - zb), Vector3(rx, sh * 0.5, (zf + zb) * 0.5)],
			# задняя
			[Vector3(rx - lx, sh, t), Vector3((rx + lx) * 0.5, sh * 0.5, zb)],
			# левая — двумя кусками, мимо самой детской: там уже есть стена с окном
			[Vector3(t, sh, -D * 0.5 - 0.3 - zb),
				Vector3(lx, sh * 0.5, (-D * 0.5 - 0.3 + zb) * 0.5)],
			[Vector3(t, sh, zf - D * 0.5 - 0.3),
				Vector3(lx, sh * 0.5, (zf + D * 0.5 + 0.3) * 0.5)]]:
		_box(piece[0], piece[1], skin, false)
	# ЛИЦО ДОМА с дверным проёмом: три куска, как у всякой стены с дверью.
	for piece in [
			[Vector3(dx - ow * 0.5 - lx, sh, t),
				Vector3((dx - ow * 0.5 + lx) * 0.5, sh * 0.5, zf)],
			[Vector3(rx - dx - ow * 0.5, sh, t),
				Vector3((rx + dx + ow * 0.5) * 0.5, sh * 0.5, zf)],
			[Vector3(ow, sh - oh, t), Vector3(dx, oh + (sh - oh) * 0.5, zf)]]:
		_box(piece[0], piece[1], skin, false)
	# ВТОРОЙ ЭТАЖ — сплошной объём: внутрь него никто не заглянет.
	_box(Vector3(rx - lx, top - up, zf - zb),
		Vector3((rx + lx) * 0.5, (top + up) * 0.5, (zf + zb) * 0.5), skin, false)
	# Пояс между этажами, карниз и снег на крыше.
	_box(Vector3(rx - lx + 0.3, 0.18, zf - zb + 0.3),
		Vector3((rx + lx) * 0.5, up + 0.02, (zf + zb) * 0.5), cor, false)
	_box(Vector3(rx - lx + 0.5, 0.26, zf - zb + 0.5),
		Vector3((rx + lx) * 0.5, top - 0.1, (zf + zb) * 0.5), cor, false)
	_box(Vector3(rx - lx + 0.3, 0.34, zf - zb + 0.3),
		Vector3((rx + lx) * 0.5, top + 0.15, (zf + zb) * 0.5), snow, false)
	# ОКНА. На улицу — те, что видно с тротуара; на правую стену — ещё два, их
	# видно с подхода. Часть горит: одно тёплое окно говорит «тут живут»
	# больше, чем весь фасад.
	var wr := RandomNumberGenerator.new()
	wr.seed = 9311
	for x in [rx - 1.9, rx - 4.6, dx - 2.0]:
		_house_pane(Vector3(x, 1.75, zf), Vector3(0, 0, 1), wr.randf() < 0.4)
	for x in [lx + 1.6, dx + 0.1, rx - 2.4, rx - 5.0]:
		_house_pane(Vector3(x, up + 1.5, zf), Vector3(0, 0, 1), wr.randf() < 0.45)
	for z in [zf - 2.4, zf - 6.0]:
		_house_pane(Vector3(rx, 1.75, z), Vector3(1, 0, 0), wr.randf() < 0.35)
		_house_pane(Vector3(rx, up + 1.5, z), Vector3(1, 0, 0), wr.randf() < 0.45)


## Окно на фасаде: тёмная рама и стекло в ней, чуть выступающее наружу.
## normal — куда смотрит окно.
func _house_pane(at: Vector3, normal: Vector3, lit: bool) -> void:
	var frame := _mat(Color(0.13, 0.13, 0.14), 0.7)
	var glass := _mat(Color(0.05, 0.06, 0.09))
	if lit:
		glass = _mat(Color(0.92, 0.80, 0.56))
		glass.emission_enabled = true
		glass.emission = Color(1.0, 0.84, 0.56)
		glass.emission_energy_multiplier = 1.3
	var w: float = 1.05
	var h: float = 1.35
	var n: Vector3 = normal.normalized()
	var size_f := Vector3(w + 0.16, h + 0.16, 0.06)
	var size_g := Vector3(w, h, 0.06)
	if absf(n.x) > 0.5:
		size_f = Vector3(0.06, h + 0.16, w + 0.16)
		size_g = Vector3(0.06, h, w)
	_box(size_f, at + n * 0.03, frame, false)
	_box(size_g, at + n * 0.05, glass, false)
	# Переплёт: одна перекладина поперёк. Без неё стекло читается экраном.
	var bar := Vector3(w, 0.05, 0.07) if absf(n.x) < 0.5 else Vector3(0.07, 0.05, w)
	_box(bar, at + n * 0.07, frame, false)


## ЗЕМЛЯ. Мостовая, тротуары и снег на всём этом.
func _street_ground(dx: float, z1: float, hall_w: float) -> void:
	var snow := _mat(Color(0.82, 0.86, 0.94), 0.92)
	var road := _mat(Color(0.13, 0.13, 0.15))
	var kerb := _mat(Color(0.30, 0.30, 0.32))
	# Улица тянется ВДОЛЬ фасада нашего дома, то есть влево-вправо: выходя, ты
	# видишь её уходящей в обе стороны, а не упирающейся в стену напротив.
	# СНЕГ ДО САМОГО ТУМАНА. Земли не было вовсе: были мостовая на девяносто
	# метров и два тротуара, а всё, что дальше, стояло НА ПУСТОТЕ — дома
	# висели в воздухе, и это видно с первого же кадра игры.
	#
	# НО НЕ ПОД ДОМОМ. Сплошная плита прошла и под детской — в двенадцати
	# сантиметрах под её полом, — и когда пол проваливается, в дыре оказывался
	# белый снег вместо двадцатичетырёхметровой шахты. Играющий так и сказал:
	# «дыра как будто тоже заполнена снегом».
	#
	# Поэтому земля кладётся рамкой вокруг дома: четыре куска с пустотой
	# посередине. Пустоту видно только сверху из самой дыры, а туда смотрят
	# ровно затем, чтобы увидеть, что дна нет.
	var ground := _mat(Color(0.80, 0.84, 0.92), 0.92)
	var far: float = 110.0
	var gx0: float = dx - 4.6     ## пустота под домом: от левой стены
	var gx1: float = dx + 9.6     ## до правой
	var gz0: float = -7.0         ## и от задней стены
	var gz1: float = z1 - 0.1     ## до самого фасада
	for piece in [
			[Vector3(gx0 - (dx - far), 0.4, far * 2.0),
				Vector3((gx0 + dx - far) * 0.5, -0.32, 0.0)],
			[Vector3(dx + far - gx1, 0.4, far * 2.0),
				Vector3((gx1 + dx + far) * 0.5, -0.32, 0.0)],
			[Vector3(gx1 - gx0, 0.4, gz0 + far),
				Vector3((gx0 + gx1) * 0.5, -0.32, (gz0 - far) * 0.5)],
			[Vector3(gx1 - gx0, 0.4, far - gz1),
				Vector3((gx0 + gx1) * 0.5, -0.32, (gz1 + far) * 0.5)]]:
		_box(piece[0], piece[1], ground, false)
	var run: float = 90.0
	var road_w: float = 9.0
	var walk_w: float = 3.2
	var zc: float = z1 + walk_w + road_w * 0.5
	_box(Vector3(run, 0.2, road_w), Vector3(dx, -0.12, zc), road, false)
	for side in [-1.0, 1.0]:
		var zw: float = zc + side * (road_w * 0.5 + walk_w * 0.5)
		# БЛИЖНИЙ ТРОТУАР ТВЁРДЫЙ: по нему игрок теперь приходит к дому, и без
		# столкновений он проваливался бы сквозь снег. Дальний оставляем
		# декорацией — туда не попасть.
		# side = −1 — это тротуар У ДОМА (меньший z), по нему игрок и приходит.
		# Стояло side > 0.0, то есть твёрдым был ДАЛЬНИЙ, за мостовой, куда не
		# попасть, а под ногами у игрока была декорация.
		_box(Vector3(run, 0.22, walk_w), Vector3(dx, -0.10, zw), snow, side < 0.0)
		_box(Vector3(run, 0.14, 0.24), Vector3(dx, 0.02, zc + side * road_w * 0.5), kerb, false)
	# СУГРОБЫ вдоль бордюра: неровные, разной длины. Именно они говорят, что
	# снег ЛЕЖИТ давно, — ровная белая полоса читается покрашенным полом.
	var srng := RandomNumberGenerator.new()
	srng.seed = 5150
	for side in [-1.0, 1.0]:
		var zw: float = zc + side * (road_w * 0.5 - 0.1)
		var x: float = dx - run * 0.5
		while x < dx + run * 0.5:
			var w: float = srng.randf_range(1.6, 4.5)
			var h: float = srng.randf_range(0.22, 0.52)
			_snow_drift(Vector3(x + w * 0.5, 0.0, zw), w, h,
				srng.randf_range(0.8, 1.5), snow, srng)
			x += w + srng.randf_range(0.3, 1.6)
	# ПОРОГ. Между полом коридора (кончается на z = 9.50) и тротуаром
	# (начинается на 9.80) зияли тридцать сантиметров, где пола НЕ БЫЛО вовсе:
	# сквозь щель видно пустоту сцены, и на скользящем взгляде она дрожала
	# полоской. Играющий это и заметил. Плита перекрывает стык с запасом.
	# Так же ниже на три миллиметра — по той же причине, см. порог детской.
	_box(Vector3(hall_w + 1.2, 0.3, 0.42), Vector3(dx, -0.153, z1 - 0.15),
		_mat(Color(0.36, 0.34, 0.33)), false)
	# И перед самой дверью — вытоптанная площадка. ВЫШЕ тротуара: она лежала на
	# −0.03 при тротуаре на +0.01, то есть была полностью им накрыта и не
	# показывалась ни разу.
	_box(Vector3(3.2, 0.16, 2.4), Vector3(dx, -0.055, z1 + 1.2),
		_mat(Color(0.62, 0.64, 0.70), 0.95))
	# ОГРАДА ПОДХОДА. Улица — декорация: у домов, мостовой и сугробов
	# столкновений нет, и ушедший в сторону игрок провалится сквозь снег и
	# пройдёт сквозь дом. Поэтому проход к двери огорожен невидимо: вдоль
	# бордюра, чтобы не выйти на мостовую, и с торцов — метрах в шестнадцати.
	#
	# Это честнее, чем делать всю улицу твёрдой: ходить там всё равно некуда,
	# а пустая улица, по которой можно гулять, читается задником сразу.
	var fence_z: float = z1 + walk_w + 0.1
	_invisible_wall(Vector3(40.0, 3.0, 0.4), Vector3(dx, 1.5, fence_z))
	for sx in [-1.0, 1.0]:
		_invisible_wall(Vector3(0.4, 3.0, walk_w + 1.0),
			Vector3(dx + sx * 17.0, 1.5, z1 + walk_w * 0.5))
	# И задняя стенка вдоль фасада нашего дома, чтобы не уйти сквозь него вбок.
	# ДВУМЯ КУСКАМИ: сплошная полоса перекрывала и сам дверной проём, то есть
	# войти в дом было нельзя — ровно то, ради чего игрок сюда идёт.
	for sx in [-1.0, 1.0]:
		_invisible_wall(Vector3(19.0, 3.0, 0.4), Vector3(dx + sx * 10.5, 1.5, z1 - 0.5))


## Невидимая преграда: меш не создаём вовсе, только тело. Нужна там, где мир
## кончается, а декорация продолжается.
func _invisible_wall(size: Vector3, at: Vector3) -> void:
	var body := StaticBody3D.new()
	var cs := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = size
	cs.shape = box
	body.add_child(cs)
	body.position = at
	add_child(body)


## СУГРОБ — НЕ ЯЩИК. Прямоугольная насыпь читается бетонным блоком, покрашенным
## в белый: у снега нет рёбер. Складываем из приплюснутых шаров внахлёст, разной
## величины и с разным наклоном — тогда у кучи получается неровный верх и мягкий
## край, а это и есть всё, что нужно глазу, чтобы признать в ней снег.
func _snow_drift(at: Vector3, length: float, height: float, width: float,
		mat: StandardMaterial3D, rng: RandomNumberGenerator,
		yaw: float = 0.0) -> void:
	# ЧАЩЕ, ЧЕМ КАЖЕТСЯ НУЖНЫМ. При шаге 0.9 комья стояли порознь и читались
	# рядом снежков. Сугроб — это ОДНА гряда, и чтобы она срослась, соседи
	# должны перекрываться, а не касаться.
	var lumps: int = maxi(4, int(length / 0.45))
	for i in lumps:
		var t: float = (float(i) + 0.5) / float(lumps)
		# Ближе к краям куча ниже: сугроб сходит на нет, а не обрывается.
		var edge: float = sin(t * PI)
		var r: float = height * (0.55 + edge * 0.75)
		var mi := MeshInstance3D.new()
		var sm := SphereMesh.new()
		sm.radius = r
		sm.height = r * 2.0
		sm.radial_segments = 10
		sm.rings = 5
		mi.mesh = sm
		mi.material_override = mat
		# ГРЯДА МОЖЕТ ЛЕЖАТЬ ПОПЕРЁК. Раньше она всегда шла по X, и на машинах,
		# которые стоят носом вдоль улицы, снег пришлось бы класть плитой.
		var off := Vector3((t - 0.5) * length + rng.randf_range(-0.12, 0.12),
			r * rng.randf_range(0.10, 0.22),
			rng.randf_range(-0.18, 0.18))
		if absf(yaw) > 0.001:
			off = Vector3(off.x * cos(yaw) - off.z * sin(yaw), off.y,
				off.x * sin(yaw) + off.z * cos(yaw))
		mi.position = at + off
		# Приплюснуть и растянуть вдоль: шар сам по себе читается мячом.
		mi.scale = Vector3(rng.randf_range(1.9, 2.6), rng.randf_range(0.30, 0.46),
			width / maxf(r, 0.01) * rng.randf_range(0.40, 0.58))
		mi.rotation_degrees = Vector3(0, rad_to_deg(yaw) + rng.randf_range(-25.0, 25.0), 0)
		add_child(mi)


## ДОМА. Два ряда, разной высоты и на разной глубине, с просветами между ними.
## Ровная стена с окнами — это и есть «дом как стена»: настоящий квартал узнаётся
## по тому, что дома РАЗНЫЕ и стоят не в линейку.
func _street_houses(dx: float, z1: float) -> void:
	var hrng := RandomNumberGenerator.new()
	hrng.seed = 7311
	var walls: Array = [
		_tex("plaster", 0.7, Color(0.40, 0.38, 0.36)),
		_tex("plaster", 0.7, Color(0.33, 0.31, 0.32)),
		_tex("plaster", 0.7, Color(0.44, 0.40, 0.35))]
	var snow := _mat(Color(0.86, 0.90, 0.96), 0.9)
	var zc: float = z1 + 3.2 + 4.5
	# Дальний ряд — напротив, за мостовой. Ближний — по нашу сторону, слева и
	# справа от двери: без него мы стоим у единственного дома в мире.
	for row in [1, -1]:
		var x: float = dx - 42.0
		while x < dx + 42.0:
			var w: float = hrng.randf_range(7.0, 13.0)
			# Пропуск между домами: проулок, сквозь который видно темноту.
			if hrng.randf() < 0.18:
				x += w * 0.6
				continue
			# Наш собственный дом стоит по эту сторону у самой двери — там не
			# строим, иначе он прорастёт сквозь коридор.
			# 5.5, А НЕ 9.0. При девяти метрах по обе стороны от двери зияла
			# пустота в семь метров, и сквозь неё с улицы была видна КОРОБКА
			# ДЕТСКОЙ — обои с рыбами снаружи дома. Соседи подходят вплотную,
			# оставляя проулок метра в два: ровно столько, чтобы луна светила
			# в окно детской и чтобы дом не оказался единственным в квартале.
			if row == -1 and absf(x + w * 0.5 - dx) < 5.5:
				x += w
				continue
			var h: float = hrng.randf_range(7.0, 15.0)
			var d: float = hrng.randf_range(6.0, 11.0)
			# ДОМА СТОЯЛИ НА ТРОТУАРАХ.
			#
			# Считалось от середины мостовой: отступ 4.5 — это её половина, и
			# только. Тротуар шириной 3.2 в счёт не входил вовсе, поэтому дома
			# обоих рядов накрывали его целиком: фасад ближнего ряда приходился
			# на дальний край ближнего тротуара, а сам дом уходил НА игрока.
			#
			# Пока игра начиналась на пороге, этого никто не видел: по тротуару
			# не ходили. Стоило вынести старт на улицу — и игрок появлялся
			# внутри чужого дома, в тринадцати метрах от своей двери.
			#
			# Линия застройки теперь по дальнему краю тротуара, у обоих рядов:
			# ближний ряд ровняется с фасадом нашего дома, дальний — за
			# мостовой и вторым тротуаром. Разброс только НАЗАД, вглубь двора,
			# чтобы никакой случайный дом не выехал обратно на тротуар.
			var line: float = z1 if row == -1 else z1 + 3.2 + 9.0 + 3.2
			var back: float = hrng.randf_range(0.0, 1.6)
			var zz: float = line + float(row) * (d * 0.5 + back)
			var mat: StandardMaterial3D = walls[hrng.randi() % walls.size()]
			var cx0: float = x + w * 0.5
			_box(Vector3(w, h, d), Vector3(cx0, h * 0.5, zz), mat, false)
			# ЦОКОЛЬ. Тёмная полоса понизу: дом стоит НА чём-то, а не воткнут
			# в снег. Стоит одну коробку, а низ фасада перестаёт висеть.
			_box(Vector3(w + 0.16, 0.9, d + 0.16), Vector3(cx0, 0.45, zz),
				_mat(Color(0.20, 0.19, 0.19)), false)
			# МЕЖЭТАЖНЫЕ ТЯГИ. Горизонтальные рёбра по фасаду через этаж: на
			# расстоянии именно они не дают стене остаться гладкой плоскостью.
			var эт: float = 1.8
			while эт < h - 1.4:
				_box(Vector3(w + 0.18, 0.12, d + 0.18), Vector3(cx0, эт + 1.25, zz),
					_mat(Color(0.30, 0.29, 0.28)), false)
				эт += 2.6
			# Карниз под крышей.
			_box(Vector3(w + 0.7, 0.3, d + 0.7), Vector3(cx0, h - 0.2, zz),
				_mat(Color(0.26, 0.25, 0.25)), false)
			_house_windows(cx0, zz, w, h, d, float(row), hrng)
			# КРЫША. Две трети домов — со скатом, остальные плоские с парапетом:
			# ровный квартал одинаковых двускатных домиков читается деревней, а
			# не городской улицей.
			if hrng.randf() < 0.66:
				var rh: float = hrng.randf_range(1.6, 3.0)
				# Конёк вдоль улицы: призма вытянута по X, значит разворот на
				# четверть оборота — PrismMesh тянет треугольник вдоль Z.
				_prism(Vector3(d, rh, w), Vector3(cx0, h + rh * 0.5, zz),
					_mat(Color(0.20, 0.19, 0.20)), PI * 0.5)
				# Снег лежит НА скате, чуть большей призмой и выше на ладонь.
				_prism(Vector3(d + 0.35, rh * 0.94, w + 0.35),
					Vector3(cx0, h + rh * 0.5 + 0.16, zz), snow, PI * 0.5)
			else:
				_box(Vector3(w + 0.4, 0.35, d + 0.4), Vector3(cx0, h + 0.17, zz),
					snow, false)
				# Парапет: тонкая стенка по краю плоской крыши.
				for сд in [-1.0, 1.0]:
					_box(Vector3(w + 0.5, 0.55, 0.18),
						Vector3(cx0, h + 0.4, zz + сд * (d * 0.5 + 0.2)),
						_mat(Color(0.28, 0.27, 0.26)), false)
			# ТРУБЫ. Одна-две на дом, со снежной шапкой. Именно они на дальнем
			# плане превращают ряд коробок в крыши: вертикальные засечки поверх
			# ровной линии кровли.
			for _t in range(1, hrng.randi_range(2, 3)):
				var tx: float = cx0 + hrng.randf_range(-w * 0.3, w * 0.3)
				var tz: float = zz + hrng.randf_range(-d * 0.25, d * 0.25)
				var th2: float = hrng.randf_range(1.0, 1.9)
				_box(Vector3(0.55, th2, 0.55), Vector3(tx, h + th2 * 0.5, tz),
					_mat(Color(0.24, 0.20, 0.19)), false)
				_box(Vector3(0.7, 0.12, 0.7), Vector3(tx, h + th2 + 0.05, tz),
					snow, false)
			x += w + hrng.randf_range(0.6, 2.4)


## Окна дома: рядами, часть горит. Светятся ТЁПЛЫМ — на холодной улице это
## единственное, что говорит «там люди».
func _house_windows(cx: float, cz: float, w: float, h: float, d: float,
		row: float, hrng: RandomNumberGenerator) -> void:
	var lit := _mat(Color(0.95, 0.82, 0.58))
	lit.emission_enabled = true
	lit.emission = Color(1.0, 0.86, 0.60)
	lit.emission_energy_multiplier = 1.5
	var dark := _mat(Color(0.06, 0.07, 0.10))
	# ГРАНЬ СТЕНЫ, а не шесть сантиметров ПЕРЕД ней. Окна стояли коробками
	# поверх фасада и вблизи читались светящимися кирпичами, приклеенными
	# снаружи, — особенно вечером, когда горящих в кадре несколько.
	var face_z: float = cz - row * d * 0.5
	var cols: int = maxi(2, int(w / 2.6))
	var rows: int = maxi(2, int((h - 2.2) / 2.6))
	for r in rows:
		for c in cols:
			var wx: float = cx - w * 0.5 + w * (float(c) + 0.5) / float(cols)
			var wy: float = 1.8 + float(r) * 2.6
			if wy > h - 1.2:
				continue
			var on: bool = hrng.randf() < 0.34
			# Рама и стекло: тёмная рамка чуть шире, стекло в ней. Одно голое
			# светлое пятно читается наклейкой, с рамкой — окном.
			_box(Vector3(1.16, 1.56, 0.05), Vector3(wx, wy, face_z - row * 0.012),
				_mat(Color(0.12, 0.12, 0.13)), false)
			_box(Vector3(1.0, 1.4, 0.05), Vector3(wx, wy, face_z - row * 0.026),
				lit if on else dark, false)
			# ПОДОКОННИК. Светлая полочка под окном: с улицы она ловит свет и
			# отделяет окно от стены — без неё окно остаётся наклейкой.
			_box(Vector3(1.3, 0.1, 0.16), Vector3(wx, wy - 0.82, face_z - row * 0.07),
				_mat(Color(0.52, 0.51, 0.49)), false)


## ФОНАРИ вдоль улицы: столб, кронштейн и тёплое пятно на снегу.
func _street_lamps(dx: float, z1: float) -> void:
	var zc: float = z1 + 3.2 + 4.5
	var post := _mat(Color(0.17, 0.17, 0.19))
	for i in 7:
		# СО СДВИГОМ: при ровном шаге от dx один столб вставал точно посреди
		# дверного проёма и закрывал собой весь вид на улицу.
		var x: float = dx - 31.0 + float(i) * 12.0
		# СТОЛБ У БОРДЮРА, А НЕ ПОСРЕДИ ТРОТУАРА. Стоял на 2.1 от края, ровно
		# на той линии, по которой игрок идёт к дому: первый кадр игры делил
		# пополам чёрный столб, а идти приходилось в обход.
		var zp: float = z1 + 2.6
		# СТОЛБ ТВЁРДЫЙ. Фонари стоят на ближнем тротуаре, по которому игрок
		# теперь идёт к дому, и сквозь столб он проходил насквозь.
		_box(Vector3(0.18, 5.2, 0.18), Vector3(x, 2.6, zp), post)
		_box(Vector3(1.1, 0.14, 0.14), Vector3(x + 0.5, 5.15, zp), post, false)
		var head := _mat(Color(0.98, 0.88, 0.66))
		head.emission_enabled = true
		head.emission = Color(1.0, 0.88, 0.62)
		head.emission_energy_multiplier = 2.2
		_box(Vector3(0.34, 0.22, 0.34), Vector3(x + 1.0, 5.0, zp), head, false)
		var l := OmniLight3D.new()
		# СНЕГ ДОЛЖЕН ОСТАВАТЬСЯ СНЕГОМ. Семь фонарей по 4.4 с радиусом в
		# одиннадцать метров перекрывали друг друга и заливали тротуар ровным
		# тёплым светом — белый снег под ногами читался песком.
		#
		# Тусклее, белее и с более резким спадом: под каждым фонарём пятно, а
		# между ними синий сумрак. Пятна и есть то, ради чего фонари ставят.
		l.light_color = Color(1.0, 0.90, 0.74)
		l.light_energy = 3.0
		l.omni_range = 8.5
		l.omni_attenuation = 2.0
		# Тень только у ближайшего к двери: семь теневых источников на улице,
		# куда игрок не выйдет, — это кадр, выброшенный в никуда.
		l.shadow_enabled = absf(x - dx) < 7.0
		l.position = Vector3(x + 1.0, 4.9, zp)
		add_child(l)


## МАШИНЫ У БОРДЮРА. Готовая модель, а не коробка: у машины слишком узнаваемый
## силуэт, чтобы подделывать его ящиками, — фальшь видно сразу и издалека.
##
## Она под чехлом, и это удача: чехол избавляет от вопроса, какой она марки и
## какого года, а на зимней улице машина под чехлом — обычное дело.
func _street_cars(dx: float, z1: float) -> void:
	var car_scene = load("res://models/car/model.gltf")
	if car_scene == null:
		return
	var zc: float = z1 + 3.2 + 4.5
	var snow := _mat(Color(0.88, 0.91, 0.96), 0.9)
	var crng := RandomNumberGenerator.new()
	crng.seed = 4242
	# Стоят вдоль ближнего к домам края, носом вдоль улицы и слегка вразнобой:
	# ровный ряд читался бы стоянкой, а не улицей, где просто оставили машины.
	for spec in [[-16.0, 1.0], [-6.5, 1.0], [9.0, -1.0], [21.0, 1.0]]:
		var car = car_scene.instantiate()
		var x: float = dx + float(spec[0])
		var zz: float = zc + 3.1
		car.position = Vector3(x, 0.0, zz)
		car.rotation_degrees = Vector3(0, 90.0 * float(spec[1]) + crng.randf_range(-4.0, 4.0), 0)
		add_child(car)
		# СНЕГ КОМЬЯМИ, А НЕ ПЛИТАМИ. Здесь лежали две коробки — на крыше и у
		# колёс, — и с тротуара они читались ровно тем, чем были: белыми
		# квадратами на машине. Тот же сугроб, что вдоль бордюра, только
		# положенный вдоль кузова: машина стоит носом вдоль улицы, поэтому
		# гряду поворачиваем на её угол.
		# УГОЛ СЧИТАЕТСЯ ОТ КУЗОВА, А НЕ ОТ ПОВОРОТА УЗЛА. Модель лежит длиной
		# по своей оси Z, и после поворота на девяносто градусов машина стоит
		# длиной по МИРОВОЙ X. Гряда же строится вдоль X, поэтому от угла
		# машины надо отнять те же девяносто — иначе сугроб ложится ПОПЕРЁК
		# машины, через всю мостовую.
		var yaw: float = deg_to_rad(car.rotation_degrees.y) - PI * 0.5
		# Крыша модели кончается на 1.41 — замерено, а не подобрано.
		_snow_drift(Vector3(x, 1.33, zz), 2.4, 0.15, 1.15, snow, crng, yaw)
		# И у колёс — ниже, шире и длиннее кузова: машину замело, а не
		# поставили минуту назад.
		_snow_drift(Vector3(x, 0.02, zz), 4.6, 0.24, 2.4, snow, crng, yaw)


## СНЕГОПАД. Частицы, а не геометрия: тысяча снежинок стоит дешевле одного
## дома, а движение оживляет улицу сильнее любой лишней стены.
func _street_snowfall(dx: float, z1: float) -> void:
	var pm := ParticleProcessMaterial.new()
	pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	# ВЫСОКИЙ ЯЩИК, А НЕ ПЛОСКИЙ. Снежинки рождались все на одной высоте, у
	# самого верха, и внизу их не было вовсе: играющий видел снег «только в
	# небе». Рождаем их СРАЗУ ВО ВСЁМ ОБЪЁМЕ от земли до крыш — тогда в любой
	# момент снег есть на каждой высоте, в том числе у тебя перед носом.
	# ЯЩИК ТОЛЬКО НАД УЛИЦЕЙ. Он был x ±38, y 0.5..22.5, z −9.2..42.8 — то есть
	# детская (x ±2.6, y 0..3, z ±2.2) лежала ЦЕЛИКОМ ВНУТРИ НЕГО, и снег шёл
	# в комнате. Низ ящика теперь выше крыши дома, а начинается он за уличной
	# дверью: внутрь не попадает ни одна снежинка.
	pm.emission_box_extents = Vector3(30.0, 8.0, 15.0)
	pm.direction = Vector3(0.25, -1.0, 0.1)
	pm.spread = 12.0
	pm.initial_velocity_min = 0.7
	pm.initial_velocity_max = 1.6
	pm.gravity = Vector3(0, -0.55, 0)
	pm.scale_min = 0.5
	pm.scale_max = 1.5
	# Ветер: без него снег падает отвесно и читается помехами на экране.
	pm.turbulence_enabled = true
	pm.turbulence_noise_strength = 0.6
	pm.turbulence_noise_scale = 1.4
	var qm := QuadMesh.new()
	qm.size = Vector2(0.055, 0.055)
	var fm := StandardMaterial3D.new()
	fm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	fm.albedo_color = Color(0.94, 0.96, 1.0, 0.85)
	fm.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	fm.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	qm.material = fm
	var ps := GPUParticles3D.new()
	ps.amount = 2600
	ps.lifetime = 11.0
	ps.process_material = pm
	ps.draw_pass_1 = qm
	ps.position = Vector3(dx, 13.0, z1 + 16.0)
	ps.visibility_aabb = AABB(Vector3(-40, -20, -26), Vector3(80, 40, 52))
	add_child(ps)


func _build_stuff() -> void:
	var wood := _tex("furniture", 1.4, Color(0.62, 0.55, 0.48))
	_build_bed(W * 0.5 - 0.75)
	# Стол у окна и стул.
	_box(Vector3(1.5, 0.08, 0.75), Vector3(-W * 0.5 + 1.1, 0.74, -0.9), wood)
	for sx in [-0.6, 0.6]:
		for sz in [-0.3, 0.3]:
			_box(Vector3(0.08, 0.74, 0.08),
				Vector3(-W * 0.5 + 1.1 + sx, 0.37, -0.9 + sz), wood, false)
	# Табурет С НОЖКАМИ: сиденье само по себе висело в воздухе доской.
	_box(Vector3(0.42, 0.06, 0.42), Vector3(-W * 0.5 + 1.1, 0.45, -0.1), wood)
	for tx in [-0.16, 0.16]:
		for tz in [-0.16, 0.16]:
			_box(Vector3(0.05, 0.42, 0.05),
				Vector3(-W * 0.5 + 1.1 + tx, 0.21, -0.1 + tz), wood, false)
	# РАСКРЫТАЯ ТЕТРАДЬ — ДВЕ СТРАНИЦЫ И КОРЕШОК, а не белый прямоугольник.
	#
	# Было: один плоский ящик 0.40 × 0.30 цветом бумаги, положенный на стол.
	# Играющий описал его ровно так, как он выглядел, — «рядом со столом висит
	# какой-то белый квадрат». Никаких признаков тетради у него не было: ни
	# разворота, ни корешка, ни следа карандаша, и лежал он строго по столу.
	#
	# Теперь две страницы расходятся под углом, между ними тёмный корешок, а на
	# правой — детский рисунок тем же генератором, что и на стене. Разворот сам
	# сообщает, что тут сидели и рисовали, и сообщает это без единой надписи.
	var nb_x: float = -W * 0.5 + 1.05
	var nb_z: float = -0.9
	var page_mat := _tex("paper", 2.6, Color(0.88, 0.86, 0.80))
	for side in [-1.0, 1.0]:
		var pg := _box(Vector3(0.19, 0.012, 0.28),
			Vector3(nb_x + side * 0.098, 0.787, nb_z), page_mat, false)
		# Страницы приподняты от корешка: разворот не лежит плоско никогда.
		pg.rotation_degrees = Vector3(0, -7.0, side * 3.5)
	var spine := _box(Vector3(0.022, 0.016, 0.28), Vector3(nb_x, 0.783, nb_z),
		_mat(Color(0.30, 0.26, 0.22)), false)
	spine.rotation_degrees = Vector3(0, -7.0, 0)
	# Рисунок на правой странице — тот же генератор, что и для рисунков на стене.
	var draw_mat := StandardMaterial3D.new()
	draw_mat.albedo_texture = _draw_tex(0)
	draw_mat.roughness = 1.0
	var sheet := _box(Vector3(0.17, 0.004, 0.25),
		Vector3(nb_x + 0.098, 0.796, nb_z), draw_mat, false)
	sheet.rotation_degrees = Vector3(0, -7.0, 3.5)
	# Карандаши рядом — россыпью, а не в стакане: тут работали, а не позировали.
	for i in 5:
		var p := _box(Vector3(0.02, 0.02, 0.17),
			Vector3(-W * 0.5 + 1.45 + float(i) * 0.05, 0.79, -0.78),
			_mat([Color(0.52, 0.24, 0.20), Color(0.24, 0.34, 0.48),
				Color(0.28, 0.44, 0.29), Color(0.56, 0.50, 0.24),
				Color(0.34, 0.27, 0.40)][i], 0.85), false)
		p.rotation_degrees = Vector3(0, randf_range(-25.0, 25.0), 0)
	# Лампа на столе — её и включают.
	_box(Vector3(0.06, 0.34, 0.06), Vector3(-W * 0.5 + 0.55, 0.95, -0.9), wood, false)
	lamp_bulb = _box(Vector3(0.20, 0.14, 0.20), Vector3(-W * 0.5 + 0.55, 1.16, -0.9),
		_mat(Color(0.85, 0.80, 0.70)), false)
	var bulb_m := lamp_bulb.material_override as StandardMaterial3D
	bulb_m.emission_enabled = true
	bulb_m.emission = Color(1.0, 0.88, 0.66)
	bulb_m.emission_energy_multiplier = 1.4
	lamp = OmniLight3D.new()
	lamp.light_color = Color(1.0, 0.86, 0.62)
	# ГОРИТ СРАЗУ. Включать её руками было первым делом игры, но комната до
	# этого стояла тёмной, и человек искал выключатель вместо того, чтобы
	# смотреть. Свет теперь есть с порога, а первым делом стал блокнот.
	lamp_on = true
	lamp.light_energy = 3.6
	lamp.omni_range = 5.0
	lamp.position = Vector3(-W * 0.5 + 0.55, 1.16, -0.9)
	add_child(lamp)
	# Рисунки на стене — ТЕ ЖЕ ФИГУРЫ, что игрок будет соединять весь дальнейший
	# час: домик, рыбка, кораблик. Раньше здесь висели пустые белые листы, и
	# завязка «она рисовала точками» держалась на честном слове.
	for i in 3:
		var dm := StandardMaterial3D.new()
		dm.albedo_texture = _draw_tex(i)
		dm.roughness = 1.0
		var d := MeshInstance3D.new()
		var qm := QuadMesh.new()
		qm.size = Vector2(0.34, 0.44)
		d.mesh = qm
		d.material_override = dm
		d.position = Vector3(-0.6 + float(i) * 0.7, 1.65, -D * 0.5 + 0.02)
		d.rotation_degrees = Vector3(0, 0, randf_range(-4.0, 4.0))
		add_child(d)
	# ПРОЛОМ. Собран заранее, но невидим: пока пол цел, лианы просто сходятся
	# в одно место на полу, и это ничего не объясняет — до поры.
	hole = Node3D.new()
	hole.position = Vector3(0, 0, 0.4)
	hole.visible = false
	add_child(hole)
	# РВАНЫЙ КРАЙ — ЭТО ЩЕПА, А НЕ ДОСКИ.
	#
	# Здесь стояло четырнадцать широких кусков (по двадцать-сорок сантиметров),
	# разложенных ровным кольцом и наклонённых каждый на свой угол. На кадре это
	# читалось кольцом откинутых люков: играющий сказал прямо — «края дыры
	# дрожат как двери». Виновата была форма, а не движение: ничего там не
	# дрожит, просто плоские створки по кругу.
	#
	# Пол, проломленный сверху, ломается ВДОЛЬ ВОЛОКНА: остаются узкие щепки,
	# торчащие внутрь дыры и вниз, разной длины и вразнобой. Отсюда три правила:
	# узкие, направленные к центру, и наклонённые в дыру, а не из неё.
	var brk := _tex("floorwood", 0.55, Color(0.40, 0.31, 0.23))
	# ПОЛ ЛОМАЕТСЯ ВДОЛЬ ДОСОК, А НЕ ПО КРУГУ.
	#
	# Здесь дважды стояло кольцо: сначала четырнадцать широких створок, потом
	# двадцать шесть щепок, разложенных через равный угол. И оба раза играющий
	# говорил одно и то же — «края дыры дрожат как двери». Замер показал, что
	# дрожи нет вовсе: при неподвижной камере кадр не меняется ни на пиксель.
	# Дело не в мерцании, а в ЧТЕНИИ: ровное кольцо одинаковых плоских кусков
	# вокруг круглой дыры читается лопастями, люками, диафрагмой — чем угодно,
	# кроме проломленного пола.
	#
	# Настоящий пол — это доски, и у пролома две разные стороны. Там, где доска
	# переломилась поперёк, торчит ТОРЕЦ шириной в доску. Там, где трещина
	# пошла вдоль волокна, отходит длинная узкая ЩЕПА. Плюс пропуски: часть
	# досок обламывается вровень с краем и не торчит никуда.
	var half: float = 0.85          ## половина выреза, см. hr выше
	var plank: float = 0.13         ## ширина половицы
	# ТОРЦЫ. Две стороны, поперечные доскам: идём вдоль края шагом в доску.
	for sz in [-1.0, 1.0]:
		var x: float = -half + 0.02
		while x < half - 0.02:
			var w: float = plank * randf_range(0.75, 1.15)
			var вылет: float = 0.0
			var r: float = randf()
			if r < 0.14:
				вылет = 0.0                      # обломилась вровень
			elif r < 0.85:
				вылет = randf_range(0.04, 0.16)  # торчит немного
			else:
				вылет = randf_range(0.18, 0.34)  # длинный обломок
			if вылет > 0.001:
				var th: float = 0.022 + randf() * 0.016
				var end := _part(hole, Vector3(w * 0.92, th, вылет),
					Vector3(x + w * 0.5, 0.012 - вылет * 0.10,
						sz * (half - вылет * 0.5)), brk)
				# Наклон ВНИЗ, в дыру, и небольшой поворот: доска, которая
				# сломалась, не остаётся горизонтальной.
				end.rotation = Vector3(sz * randf_range(0.05, 0.40),
					randf_range(-0.09, 0.09), randf_range(-0.10, 0.10))
			x += w
	# ЩЕПА ВДОЛЬ ВОЛОКНА. Две другие стороны: здесь доска не переломилась, а
	# расщепилась, и в дыру заходят узкие длинные занозы разной длины.
	for sx in [-1.0, 1.0]:
		var z: float = -half + 0.05
		while z < half - 0.05:
			var шаг: float = randf_range(0.07, 0.19)
			if randf() < 0.45:
				var дл: float = randf_range(0.10, 0.46)
				var шир: float = 0.012 + randf() * 0.030
				var sl := _part(hole, Vector3(дл, 0.016 + randf() * 0.012, шир),
					Vector3(sx * (half - дл * 0.5), 0.010 - дл * 0.06, z), brk)
				sl.rotation = Vector3(randf_range(-0.10, 0.10),
					randf_range(-0.05, 0.05), sx * randf_range(0.08, 0.5))
			z += шаг
	# КРОМКА. Даже с обломанными торцами вырез остаётся РОВНОЙ ЛИНИЕЙ: квадрат
	# видно по прямому срезу, особенно с ближней стороны, откуда игрок и
	# смотрит. Поэтому по всему периметру идёт мелкая щепа вплотную к краю —
	# сантиметры, а не десятки, — и прямая перестаёт быть прямой.
	for сторона in 4:
		var вдоль: float = -half
		while вдоль < half:
			var дш: float = randf_range(0.03, 0.09)
			var выс: float = randf_range(0.010, 0.026)
			var глуб: float = randf_range(0.02, 0.07)
			var наружу: float = randf_range(-0.02, 0.03)
			var поз: Vector3
			var пов: Vector3
			match сторона:
				0: поз = Vector3(вдоль + дш * 0.5, выс * 0.4, -half + наружу)
				1: поз = Vector3(вдоль + дш * 0.5, выс * 0.4, half - наружу)
				2: поз = Vector3(-half + наружу, выс * 0.4, вдоль + дш * 0.5)
				_: поз = Vector3(half - наружу, выс * 0.4, вдоль + дш * 0.5)
			var разм: Vector3 = (Vector3(дш, выс, глуб) if сторона < 2
				else Vector3(глуб, выс, дш))
			пов = Vector3(randf_range(-0.25, 0.25), randf_range(-0.3, 0.3),
				randf_range(-0.25, 0.25))
			var chip := _part(hole, разм, поз, brk)
			chip.rotation = пов
			вдоль += дш + randf_range(0.0, 0.03)
	# И ДВЕ-ТРИ ДОСКИ, ПОВИСШИЕ В ДЫРЕ. Они держатся одним концом и уходят
	# вниз круто: это и говорит, что под полом пустота, а не подвал по колено.
	for i in 3:
		var сторона: int = i % 2
		var поперёк: float = randf_range(-half * 0.7, half * 0.7)
		var зн: float = 1.0 if randf() < 0.5 else -1.0
		var дл2: float = 0.34 + randf() * 0.26
		var ph := _part(hole, Vector3(plank * 0.9, 0.024, дл2),
			(Vector3(поперёк, -дл2 * 0.30, зн * (half - дл2 * 0.30)) if сторона == 0
				else Vector3(зн * (half - дл2 * 0.30), -дл2 * 0.30, поперёк)), brk)
		ph.rotation = (Vector3(зн * randf_range(0.7, 1.1), 0.0, randf_range(-0.12, 0.12))
			if сторона == 0
			else Vector3(randf_range(-0.12, 0.12), PI * 0.5, зн * randf_range(0.7, 1.1)))
	# Пара досок, отлетевших от края. Пол не проваливается аккуратно.
	for i in 4:
		var a3: float = randf() * TAU
		var r3: float = 1.15 + randf() * 0.5
		var pl := _part(hole, Vector3(0.16, 0.04, 0.62 + randf() * 0.3),
			Vector3(cos(a3) * r3, 0.02, sin(a3) * r3), brk)
		pl.rotation = Vector3(0, randf() * TAU, 0)
	_build_vines(Vector3(0, 0.02, 0.4))


## СИЛУЭТ ПОД ОДЕЯЛОМ, ЗАДАННЫЙ ЧИСЛАМИ, А НЕ ШАРАМИ. Раньше под одеялом лежали
## три эллипсоида: гладкие, одинаковые, с натянутой на каждый тканью — и это
## читалось гусеницей, а не ребёнком. Здесь одеяло — одна сплошная поверхность,
## а тело задаёт её высоту: [x, z, полуширина, полудлина, высота].
const BODY := [
	[0.00, -0.44, 0.22, 0.26, 0.150],   ## плечи
	[-0.01, -0.07, 0.19, 0.28, 0.112],  ## спина
	[0.02, 0.21, 0.19, 0.20, 0.126],    ## бёдра
	[0.07, 0.47, 0.13, 0.16, 0.132],    ## подтянутые колени
	[0.06, 0.68, 0.11, 0.14, 0.072],    ## голени
	[0.05, 0.83, 0.09, 0.10, 0.050],    ## ступни
]


## Высота ткани над матрасом в точке кровати. Тело — сумма плавных бугров,
## поверх — складки: без них любая ткань выглядит натянутой плёнкой.
func _drape_h(x: float, z: float) -> float:
	var h: float = 0.022
	for b in BODY:
		var dx: float = (x - float(b[0])) / float(b[2])
		var dz: float = (z - float(b[1])) / float(b[3])
		var q: float = 1.0 - dx * dx - dz * dz
		if q > 0.0:
			h += float(b[4]) * pow(q, 1.35)
	var w: float = 0.011 * sin(x * 18.0 + z * 5.5)
	w += 0.008 * sin(z * 12.5 - x * 8.0)
	w += 0.005 * sin((x + z) * 26.0 + 1.7)
	# Складки крупнее там, где ткань лежит свободно, и почти пропадают на
	# натянутых местах — на плече и на колене.
	return h + w * clampf(1.5 - h * 4.5, 0.20, 1.0)


## ОДЕЯЛО ОДНОЙ ПОВЕРХНОСТЬЮ. Сетка по кровати: середина лежит на теле, края
## свисают с матраса, у плеч — отворот. Нормали считаются по соседям, поэтому
## свет ложится по складкам, а не ровным пятном.
func _drape_mesh() -> ArrayMesh:
	var skirt: int = 5
	var drop: float = 0.235
	var xs: Array[float] = []
	var xd: Array[float] = []
	for i in skirt:
		xs.append(-0.445)
		xd.append(drop * float(skirt - i) / float(skirt))
	var cols: int = 46
	for i in cols:
		xs.append(lerpf(-0.445, 0.445, float(i) / float(cols - 1)))
		xd.append(0.0)
	for i in skirt:
		xs.append(0.445)
		xd.append(drop * float(i + 1) / float(skirt))
	var zs: Array[float] = []
	var zd: Array[float] = []
	var lip: int = 4
	for i in lip:
		zs.append(-0.56 - 0.024 * float(lip - i))
		zd.append(-0.032 * float(lip - i) / float(lip))
	var rows: int = 78
	for i in rows:
		zs.append(lerpf(-0.56, 0.93, float(i) / float(rows - 1)))
		zd.append(0.0)
	for i in skirt:
		zs.append(0.93)
		zd.append(drop * float(i + 1) / float(skirt))
	var nc: int = xs.size()
	var nr: int = zs.size()
	var g: Array = []
	for r in nr:
		var row: Array = []
		for c in nc:
			var x: float = xs[c]
			if xd[c] > 0.0:
				# Свисающий край не доска: он гуляет вдоль кровати.
				x += signf(x) * (0.006 + 0.006 * sin(zs[r] * 7.3)) * (xd[c] / drop)
			var y: float = BED_TOP + _drape_h(xs[c], zs[r]) - xd[c] - zd[r]
			row.append(Vector3(x, y, zs[r]))
		g.append(row)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var uw: float = 1.36 * 2.0
	var ul: float = 1.86 * 2.0
	for r in nr - 1:
		for c in nc - 1:
			for q in [[r, c], [r, c + 1], [r + 1, c], [r + 1, c], [r, c + 1],
					[r + 1, c + 1]]:
				var rr: int = int(q[0])
				var cc: int = int(q[1])
				st.set_normal(_grid_n(g, rr, cc, nr, nc))
				st.set_uv(Vector2(float(cc) / float(nc - 1) * uw,
					float(rr) / float(nr - 1) * ul))
				st.add_vertex(g[rr][cc])
	st.generate_tangents()
	return st.commit()


## Нормаль узла сетки по соседям. Считать её по граням нельзя: на свисающем
## крае грани почти вертикальные, и шов между верхом и краем становится виден.
func _grid_n(g: Array, r: int, c: int, nr: int, nc: int) -> Vector3:
	var a: Vector3 = g[r][maxi(c - 1, 0)]
	var b: Vector3 = g[r][mini(c + 1, nc - 1)]
	var d: Vector3 = g[maxi(r - 1, 0)][c]
	var e: Vector3 = g[mini(r + 1, nr - 1)][c]
	var n: Vector3 = (e - d).cross(b - a)
	if n.length() < 0.000001:
		return Vector3.UP
	return n.normalized()


## ГОЛОВА. Не шар: у шара нет затылка, челюсти и подбородка, а именно по ним
## голову и узнают краем глаза. Лица не будет — она отвёрнута к стене, — но
## затылок и скула должны быть настоящими, иначе из-под одеяла торчит мяч.
func _head_p(n: Vector3, th: float, phi: float, hair: bool) -> Vector3:
	var p := Vector3(n.x * 0.074, n.y * 0.087, n.z * 0.091)
	# Затылок — не полусфера, он выступает назад и вниз.
	p.z -= 0.013 * pow(maxf(0.0, -n.z), 2.0)
	# Ниже глаз череп сужается к челюсти.
	var low: float = smoothstep(-0.08, -0.85, n.y)
	p.x *= 1.0 - 0.30 * low
	p.z *= 1.0 - 0.09 * low
	# Подбородок и нос — маленькие, детские.
	var chin: float = maxf(0.0, n.z * 0.55 - n.y * 0.83)
	p += Vector3(0.0, -0.005, 0.011) * pow(chin, 6.0)
	var nose: float = maxf(0.0, n.z * 0.985 + n.y * 0.17)
	p.z += 0.013 * pow(nose, 20.0)
	# Лоб чуть плоский, макушка чуть примята подушкой.
	p.z -= 0.005 * pow(maxf(0.0, n.z * 0.5 + n.y * 0.86), 4.0)
	p.y *= 1.0 - 0.06 * pow(maxf(0.0, n.y), 3.0)
	# Уши.
	var ear: float = maxf(0.0, absf(n.x) * 0.99 + n.y * 0.05 - absf(n.z) * 0.12)
	p.x += signf(n.x) * 0.009 * pow(ear, 13.0)
	if not hair:
		return p
	# ВОЛОСЫ — ОТДЕЛЬНАЯ ОБОЛОЧКА поверх черепа, но только там, где они растут.
	# Где их нет, оболочка уходит ВНУТРЬ головы: если положить её вплотную,
	# две поверхности начинают спорить за один пиксель и картинка дрожит.
	var d: float = n.z * 0.85 - n.y * 0.62 + absf(n.x) * 0.16
	var m: float = clampf((0.26 - d) / 0.30, 0.0, 1.0)
	var strand: float = 0.0040 * sin(th * 33.0) + 0.0026 * sin(phi * 22.0 + th * 4.0)
	return p + p.normalized() * (-0.005 + m * (0.013 + strand))


func _head_mesh(hair: bool) -> ArrayMesh:
	var nu: int = 46
	var nv: int = 32
	var g: Array = []
	for j in nv + 1:
		var row: Array = []
		var phi: float = PI * float(j) / float(nv)
		for i in nu + 1:
			var th: float = TAU * float(i) / float(nu)
			var n := Vector3(sin(phi) * sin(th), cos(phi), sin(phi) * cos(th))
			row.append(_head_p(n, th, phi, hair))
		g.append(row)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for j in nv:
		for i in nu:
			for q in [[j, i], [j, i + 1], [j + 1, i], [j + 1, i], [j, i + 1],
					[j + 1, i + 1]]:
				var jj: int = int(q[0])
				var ii: int = int(q[1])
				var v: Vector3 = g[jj][ii]
				st.set_normal(_grid_n(g, jj, ii, nv + 1, nu + 1))
				st.set_uv(Vector2(float(ii) / float(nu) * 3.0,
					float(jj) / float(nv) * 2.0))
				st.add_vertex(v)
	st.generate_tangents()
	return st.commit()


## Мелкий рельеф из шума. Кожа и штукатурка без него — залитый цвет: свет
## ложится ровным пятном, и любая поверхность становится пластмассой.
func _noise_normal(freq: float, bump: float) -> NoiseTexture2D:
	var nt := NoiseTexture2D.new()
	nt.width = 256
	nt.height = 256
	nt.seamless = true
	nt.as_normal_map = true
	nt.bump_strength = bump
	var fn := FastNoiseLite.new()
	fn.noise_type = FastNoiseLite.TYPE_SIMPLEX
	fn.frequency = freq
	nt.noise = fn
	return nt


func _skin_mat() -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(0.66, 0.55, 0.50)
	m.roughness = 0.62
	m.metallic = 0.0
	m.normal_enabled = true
	m.normal_texture = _noise_normal(0.22, 1.4)
	m.normal_scale = 0.55
	m.uv1_scale = Vector3(4.0, 4.0, 4.0)
	# Кожа просвечивает. Без этого голова — крашеный гипс.
	m.subsurf_scatter_enabled = true
	m.subsurf_scatter_strength = 0.42
	m.subsurf_scatter_skin_mode = true
	return m


func _hair_mat() -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(0.115, 0.093, 0.088)
	m.roughness = 0.66
	m.metallic = 0.0
	m.normal_enabled = true
	m.normal_texture = _noise_normal(0.55, 3.0)
	m.normal_scale = 1.0
	m.uv1_scale = Vector3(6.0, 1.0, 1.0)
	# Блик на волосах вытянут вдоль пряди, а не круглый.
	m.anisotropy_enabled = true
	m.anisotropy = 0.55
	return m


## Модель со сканера: поставить, повернуть, задать размер.
func _model(scene: PackedScene, pos: Vector3, yaw: float,
		scl: float = 1.0) -> Node3D:
	var n: Node3D = scene.instantiate()
	n.position = pos
	n.rotation.y = yaw
	n.scale = Vector3(scl, scl, scl)
	add_child(n)
	return n


## КРОВАТЬ И ТА, КТО В НЕЙ. Первые тридцать секунд игры человек смотрит сюда,
## и всё остальное в комнате он оценит по этому месту.
func _build_bed(bx: float) -> void:
	var bz: float = -0.6
	# Рама — скан старой железной кровати (CC0). Изголовье у неё со стороны
	# −Z, то есть у дальней стены: девочка лежит головой туда.
	_model(BedScene, Vector3(bx, 0.0, bz), 0.0)
	# Столкновения отдельно: у скана их нет, а сквозь кровать ходить нельзя.
	var body := StaticBody3D.new()
	body.position = Vector3(bx, 0.0, bz)
	add_child(body)
	for c in [[Vector3(0.96, 0.72, 2.04), Vector3(0.0, 0.36, 0.0)],
			[Vector3(0.96, 1.22, 0.08), Vector3(0.0, 0.61, -1.0)]]:
		var cs := CollisionShape3D.new()
		var sh := BoxShape3D.new()
		sh.size = c[0]
		cs.shape = sh
		cs.position = c[1]
		body.add_child(cs)
	girl = Node3D.new()
	girl.position = Vector3(bx, 0.0, bz)
	add_child(girl)
	# Матрас. Верх на 0.66 — ровно на сетке рамы.
	var mat_mesh := MeshInstance3D.new()
	var mb := BoxMesh.new()
	mb.size = Vector3(0.845, 0.17, 1.88)
	mat_mesh.mesh = mb
	mat_mesh.material_override = _tex("linen", 1.9, Color(0.80, 0.75, 0.66))
	mat_mesh.position = Vector3(0.0, BED_TOP - 0.085, 0.0)
	girl.add_child(mat_mesh)
	# Одеяло.
	var blanket := MeshInstance3D.new()
	blanket.mesh = _drape_mesh()
	var cloth := _tex("blanket", 1.3, Color(0.66, 0.63, 0.62))
	cloth.cull_mode = BaseMaterial3D.CULL_DISABLED
	blanket.material_override = cloth
	girl.add_child(blanket)
	# Подушка — тоже скан; цвет приглушён множителем, иначе она кричит на всю
	# комнату узором.
	var pil: Node3D = PillowScene.instantiate()
	pil.position = Vector3(0.02, BED_TOP + 0.088, -0.76)
	pil.rotation = Vector3(0.0, 0.09, 0.0)
	pil.scale = Vector3(1.20, 0.80, 1.06)
	girl.add_child(pil)
	# У скана свой узор — красно-оранжевые треугольники. В детской он кричит на
	# всю комнату, поэтому форму берём от скана, а ткань свою.
	_face(pil, "throw_pillows_01_pillow01", false)
	_reskin(pil, _tex("linen", 2.4, Color(0.88, 0.86, 0.82)))
	# ГОЛОВА. Лицом к стене: лица нет и не будет, а затылок ребёнка на подушке
	# говорит ровно то, что нужно — с ней ничего нельзя сделать.
	var head := Node3D.new()
	head.position = Vector3(0.02, BED_TOP + 0.215, -0.66)
	head.rotation = Vector3(0.12, PI * 0.40, -0.30)
	head.scale = Vector3(1.14, 1.14, 1.14)
	girl.add_child(head)
	var skull := MeshInstance3D.new()
	skull.mesh = _head_mesh(false)
	skull.material_override = _skin_mat()
	head.add_child(skull)
	var hair := MeshInstance3D.new()
	hair.mesh = _head_mesh(true)
	hair.material_override = _hair_mat()
	head.add_child(hair)
	# Пряди по подушке: без них голова кончается ровной шапкой.
	var hm: StandardMaterial3D = _hair_mat()
	for i in 7:
		var a: float = -0.9 + float(i) * 0.30
		# Пряди уходят НАЗАД, на подушку. Раньше они торчали вбок и вперёд —
		# из головы получался чёрный ёж.
		_lock(girl, Vector3(0.02 + sin(a) * 0.04, BED_TOP + 0.23, -0.72),
			Vector3(0.02 + sin(a) * 0.13, BED_TOP + 0.135,
				-0.80 - absf(cos(a)) * 0.10), hm)
	# БЛОКНОТ на одеяле: обучение живёт здесь, а не в подсказках. Лежит криво —
	# его положили, а не поставили.
	var bh: float = BED_TOP + _drape_h(-0.24, 0.36) + 0.012
	book = _box(Vector3(0.27, 0.028, 0.20), Vector3(bx - 0.24, bh, bz + 0.36),
		_tex("paper", 2.6, Color(0.46, 0.34, 0.24)), false)
	book.rotation = Vector3(0.0, 0.28, 0.0)
	# Бумага отдельным листом поверх обложки: одна белая плита читалась куском
	# пенопласта, а не тетрадью.
	var pg := _box(Vector3(0.245, 0.020, 0.178), Vector3(bx - 0.24, bh + 0.012,
		bz + 0.365), _tex("paper", 3.4, Color(0.80, 0.77, 0.70)), false)
	pg.rotation = Vector3(0.0, 0.28, 0.0)
	# Тумбочка у изголовья и утка на полу: комната обжитая, а не выставочная.
	_model(StandScene, Vector3(bx - 0.82, 0.04, bz - 0.72), -PI * 0.5)


## Прядь волос: короткая цепочка сужающихся звеньев с провисанием.
func _lock(parent: Node3D, from: Vector3, to: Vector3,
		mat: Material) -> void:
	var segs: int = 5
	var prev: Vector3 = from
	for k in range(1, segs + 1):
		var t: float = float(k) / float(segs)
		var p: Vector3 = from.lerp(to, t)
		p.y -= sin(t * PI) * 0.012
		var d: Vector3 = p - prev
		var l: float = maxf(d.length(), 0.001)
		var seg := MeshInstance3D.new()
		var cm := CylinderMesh.new()
		cm.top_radius = 0.008 * (1.0 - t * 0.7)
		cm.bottom_radius = 0.008 * (1.0 - (t - 1.0 / float(segs)) * 0.7)
		cm.height = l
		cm.radial_segments = 6
		seg.mesh = cm
		seg.material_override = mat
		seg.position = (prev + p) * 0.5
		seg.look_at_from_position(seg.position, p, Vector3.UP)
		seg.rotate_object_local(Vector3.RIGHT, PI * 0.5)
		parent.add_child(seg)
		prev = p


## Заменить ткань готовой модели своей. Прежняя версия множила цвет на месте
## и не срабатывала: у сканов нет переопределённых материалов, и счётчик
## переопределений всегда ноль — цикл ни разу не выполнялся.
func _reskin(n: Node, mat: Material) -> void:
	if n is MeshInstance3D:
		var mi: MeshInstance3D = n
		mi.material_override = mat
	for ch in n.get_children():
		_reskin(ch, mat)


## Показать или спрятать часть модели по имени узла.
func _face(n: Node, part: String, on: bool) -> void:
	if n.name == part and n is Node3D:
		var v: Node3D = n
		v.visible = on
	for ch in n.get_children():
		_face(ch, part, on)


## ЛИАНЫ. Тонкие чёрные жилы тянутся ОТ ВСЕХ СТЕН к одной точке пола. Они не
## угрожают и ничего не делают — они показывают направление. Игрок не читает
## подсказок, но взгляд сам идёт вдоль линии и упирается туда, куда надо.
##
## И это первое, что в комнате неправильно: обои, кровать, лампа — всё обычное,
## а по стенам расползлось вот это.
func _build_vines(to: Vector3) -> void:
	var mat := _mat(Color(0.05, 0.05, 0.06))
	var starts: Array = []
	# ПО ПЯТЬ С КАЖДОЙ СТЕНЫ, а не по три: двенадцать жил на всю комнату
	# терялись — стены казались просто пустыми, и «всё тянется к пролому» не
	# читалось. Двадцать штук уже похожи на то, что комнату оплело.
	for i in 5:
		var h: float = 0.35 + float(i) * 0.52
		var t2: float = float(i) / 4.0
		starts.append(Vector3(-W * 0.5 + 0.02, h, -1.6 + t2 * 3.2))
		starts.append(Vector3(W * 0.5 - 0.02, h, 1.6 - t2 * 3.2))
		starts.append(Vector3(-1.8 + t2 * 3.6, h, -D * 0.5 + 0.02))
		# НЕ ПОПЕРЁК ДВЕРИ. Жилы на этой стене шли с шагом 0.9 от 1.8 до −1.8, и
		# одна из пяти вставала ровно в x = 0 — то есть в середину проёма, где
		# стены нет. На пяти высотах сразу: играющий увидел линии, висящие в
		# дверях «как будто там стена», и был прав, стены там нет.
		var sx: float = 1.8 - t2 * 3.6
		var keep: float = door_w * 0.5 + 0.22
		if absf(sx - door_x) < keep:
			sx = door_x + (keep if sx >= door_x else -keep)
		starts.append(Vector3(sx, h, D * 0.5 - 0.02))
	for st in starts:
		var v := Node3D.new()
		add_child(v)
		# Жила — цепочка коротких звеньев: она должна ИЗГИБАТЬСЯ по стене и полу,
		# а не идти по прямой сквозь комнату.
		var segs: int = 9
		var prev: Vector3 = st
		for k in range(1, segs + 1):
			var t: float = float(k) / float(segs)
			# Сначала сползает по стене вниз, потом тянется по полу к пролому.
			var down: Vector3 = Vector3(st.x, lerpf(st.y, 0.03, minf(1.0, t * 1.8)), st.z)
			# Цель — не центр, а точка на краю пролома со стороны своей стены:
			# двенадцать жил, сходящихся в одну точку, читались звездой, а не
			# тем, что доползло до дыры и обхватило её.
			var away: Vector3 = Vector3(st.x - to.x, 0.0, st.z - to.z).normalized()
			var rim: Vector3 = Vector3(to.x, 0.03, to.z) + away * 0.82
			var p: Vector3 = down.lerp(rim, maxf(0.0, t * 1.6 - 0.6))
			# Лёгкий изгиб вбок, чтобы не было прямых линеек.
			p.x += sin(t * 3.4 + st.z) * 0.16 * (1.0 - t)
			p.z += cos(t * 3.1 + st.x) * 0.16 * (1.0 - t)
			var d: Vector3 = p - prev
			var l: float = maxf(d.length(), 0.001)
			var seg := MeshInstance3D.new()
			var cm := CylinderMesh.new()
			# Толщина у каждой своя: одинаковые жилы читаются проводами.
			var thick: float = float(v.get_index() % 3) * 0.006 + 0.010
			cm.top_radius = thick * (1.0 - t * 0.5)
			cm.bottom_radius = (thick + 0.005) * (1.0 - t * 0.5)
			cm.height = l
			cm.radial_segments = 6
			seg.mesh = cm
			seg.material_override = mat
			seg.position = prev + d * 0.5
			seg.rotation = Vector3(acos(clampf(d.y / l, -1.0, 1.0)),
				atan2(d.x, d.z), 0.0)
			v.add_child(seg)
			prev = p
		vines.append(v)


func _build_ui() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)
	hud = Label.new()
	hud.set_anchors_preset(Control.PRESET_BOTTOM_WIDE)
	hud.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hud.offset_top = -70.0
	hud.z_index = 4        # подсказка поверх полотна, а не под его палитрой
	hud.add_theme_color_override("font_color", Color(0.86, 0.85, 0.82))
	hud.add_theme_font_size_override("font_size", 17)
	# Пусто: надпись про комнату ставит _greet_room, когда игрок войдёт.
	hud.text = ""
	layer.add_child(hud)
	# Блокнот открывается настоящим полотном — тем же, что в лабиринте. Так
	# обучение не «объясняет правила», а даёт их сделать.
	board = BoardScript.new()
	board.set_anchors_preset(Control.PRESET_FULL_RECT)
	board.visible = false
	board.solved.connect(_on_book_done)
	board.failed.connect(_on_book_done)
	board.abandoned.connect(_on_book_done)
	layer.add_child(board)
	dark = ColorRect.new()
	dark.color = Color(0, 0, 0, 0)
	dark.mouse_filter = Control.MOUSE_FILTER_IGNORE
	dark.set_anchors_preset(Control.PRESET_FULL_RECT)
	layer.add_child(dark)


func _unhandled_input(event: InputEvent) -> void:
	# Полный экран работает и здесь: пролог — первое, что видит игрок, и жать
	# F11 он будет именно тут.
	if event.is_action_pressed("fullscreen"):
		Settings.toggle_fullscreen()
		return
	if stage == 0 or stage >= 4:
		return
	if not event.is_action_pressed("read"):
		return
	var p: Vector3 = player.global_position
	# Лампа: свет включают руками, и это первое, что делает человек в комнате.
	if not lamp_on and p.distance_to(lamp.position) < 1.6:
		lamp_on = true
		# И ЛАМПА ТЕПЕРЬ РЕШАЕТ. Раньше 2.6 добавлялись к уже светлой комнате и
		# терялись; теперь это единственный тёплый источник в холодной ночи, и
		# разницу видно сразу.
		lamp.light_energy = 3.6
		sfx.play("click", -2.0)
		var bm := lamp_bulb.material_override as StandardMaterial3D
		bm.emission_enabled = true
		bm.emission = Color(1.0, 0.88, 0.66)
		bm.emission_energy_multiplier = 1.4
		hud.text = Lang.t("p_book")
		return
	if board.visible:
		return
	if stage == 1 and p.distance_to(book.global_position) < 1.6:
		# Открываем блокнот: обычный детский рисунок, без таймера на нервах.
		var rng := RandomNumberGenerator.new()
		rng.randomize()
		var sh: Dictionary = Shapes.TUTOR[rng.randi() % Shapes.TUTOR.size()]
		# Подсказку — наверх: внизу её закрывает палитра порядка цветов.
		hud.set_anchors_preset(Control.PRESET_TOP_WIDE)
		hud.offset_top = 22.0
		board.tutor = true
		sfx.play("scrape", -8.0)
		board.open(sh, 0, 0.0, 0, rng.randi())
		board.visible = true
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		player.set_physics_process(false)
		hud.text = Lang.t("p_draw")


## Блокнот закрыт — как бы он ни закрылся. Провалить его нельзя: это не
## испытание, а первое знакомство с тем, чем ты будешь занят всю игру.
func _on_book_done() -> void:
	board.visible = false
	hud.set_anchors_preset(Control.PRESET_BOTTOM_WIDE)
	hud.offset_top = -70.0
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	player.set_physics_process(true)
	stage = 2
	read_t = 2.4
	hud.text = Lang.t("p_read")


## Сколько по полу до пролома. Высота не в счёт: он ходит по полу.
## Надпись встречает его НА ПОРОГЕ ДЕТСКОЙ, а не в начале коридора. Сработает
## один раз: дальше подсказку перебивают лампа, блокнот и всё остальное.
func _greet_room() -> void:
	if greeted or player == null or stage != 1:
		return
	if player.global_position.z > D * 0.5 - 0.1:
		return
	greeted = true
	# Про лампу больше не пишем: она горит. Первое дело — блокнот на одеяле.
	hud.text = Lang.t("p_book")


## ОТКАЗ ВЫЙТИ. Игрок идёт к двери — и упирается не в невидимую стену, а в
## собственную реплику. Разница огромная: невидимая стена читается как «игра
## недоделана», а отказ — как характер. Он и правда только что оттуда пришёл.
##
## Срабатывает ПО РАССТОЯНИЮ, за метр с лишним до преграды: если сначала
## воткнуться носом, а потом прочитать объяснение, объяснение уже не помогает.
func _try_leave(delta: float) -> void:
	out_said = maxf(0.0, out_said - delta)
	if player == null or stage >= 3:
		return
	# ТОЛЬКО ПОСЛЕ ТОГО, КАК ЗАШЁЛ. Игра теперь начинается на улице, и без
	# этой проверки «я только что оттуда пришёл» встречало бы игрока на
	# подходе к дому — то есть отказывало бы ему войти.
	if not been_in:
		return
	if player.global_position.distance_to(door_pos) > 2.2:
		return
	if out_said > 0.0:
		return
	# НЕ ОТ ПОДХОДА, А ОТ ПОПЫТКИ. Раньше хватало оказаться рядом — и фраза
	# срабатывала, даже если человек просто прошёл мимо двери вглубь коридора.
	# Смысл её в отказе, а отказывают в ответ на действие: идём ли мы НАРУЖУ.
	var v: Vector3 = player.velocity
	if v.z < 0.6 or Vector2(v.x, v.z).length() < 0.5:
		return
	# Двенадцать секунд: повторять на каждом шаге — это назойливо, а сказать
	# один раз за всю комнату мало, к двери подходят не сразу.
	out_said = 12.0
	hud.text = Lang.t("p_out")
	if sfx != null:
		sfx.play("breath", -8.0)


## ШАГ. Пролог до сих пор был беззвучным: звук шагов заводит world.gd, а до
## него очередь доходит только в лабиринте. На улице это слышно сразу — идёшь
## по снегу и не слышишь снега.
##
## Снаружи — хруст, внутри пока молчим: записи шагов по дереву нет, а снег в
## коридоре звучал бы хуже тишины.
func _on_step() -> void:
	if player == null or sfx == null:
		return
	if _outdoors():
		# −21 дБ: записи снега на 3.5 дБ тише «мокрых» из лабиринта, а тут шаг —
		# главное, что слышно, и прятать его незачем. Разброс по высоте
		# обязателен: образцов три, без разброса они узнаются на втором десятке.
		sfx.play("snow", -21.0, 0.11)
		_leave_print()
		return
	# В ДОМЕ — ДОСКИ. Тише, чем на улице: снаружи шаг слышно на всю пустую
	# улицу, а в коридоре он ближе к тебе и не должен перебивать шкатулку.
	sfx.play("wood", -24.0, 0.09)


## Снаружи ли игрок: за плоскостью уличной двери.
func _outdoors() -> bool:
	return player != null and player.global_position.z > street_door_z + 0.2


## СЛЕД. Тёмный отпечаток подошвы под ногой, со смещением вбок — попеременно
## влево-вправо, иначе получается одна колея посередине, будто ехал.
##
## Следы держим числом: PRINT_MAX штук, дальше самый старый уезжает. Иначе за
## пять минут топтания у двери их станут тысячи.
func _leave_print() -> void:
	if print_tex == null:
		print_tex = _make_print()
	var fwd: Vector3 = -player.global_transform.basis.z
	fwd.y = 0.0
	if fwd.length() < 0.01:
		return
	fwd = fwd.normalized()
	var side: Vector3 = Vector3(-fwd.z, 0.0, fwd.x)
	foot_l = not foot_l
	# Разнос шире и с разбросом: при ровных тринадцати сантиметрах след ложился
	# в одну ниточку по осевой — так ходит циркуль, а не человек.
	var off: float = 0.19 if foot_l else -0.19
	var at: Vector3 = player.global_position + side * off + fwd * randf_range(-0.07, 0.07)
	# Стопа, а не глаз: global_position.y — центр капсулы, и он выше пола ровно
	# на STAND_Y. Сантиметр сверху — чтобы след не мерцал в одной плоскости
	# с тротуаром.
	at.y = player.global_position.y - PlayerScript.STAND_Y + 0.012

	var m := MeshInstance3D.new()
	var q := QuadMesh.new()
	q.size = Vector2(0.20, 0.36)
	m.mesh = q
	var mat := StandardMaterial3D.new()
	mat.albedo_texture = print_tex
	mat.albedo_color = Color(1, 1, 1, 0.9)
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	m.material_override = mat
	m.position = at
	# Квад лежит в плоскости XY — кладём его на пол и доворачиваем по ходу.
	m.rotation = Vector3(-PI * 0.5,
		atan2(fwd.x, fwd.z) + PI + deg_to_rad(randf_range(-9.0, 9.0)), 0.0)
	add_child(m)
	prints.append(m)
	while prints.size() > PRINT_MAX:
		var old = prints.pop_front()
		if is_instance_valid(old):
			old.queue_free()


## Отпечаток рисуем сами: подошва — вытянутый овал, каблук — короткий, между
## ними просвет. Готовой текстуры под это нет, а прямоугольник читается
## наклейкой, а не следом.
func _make_print() -> Texture2D:
	var w := 48
	var h := 88
	var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	# Две «лепёшки»: носок с пяткой. cy — центр по высоте, ry — полувысота.
	var parts := [[0.34, 0.30, 0.42], [0.79, 0.15, 0.36]]
	for part in parts:
		var cy: float = part[0] * float(h)
		var ry: float = part[1] * float(h)
		var rx: float = part[2] * float(w)
		for y in range(h):
			for x in range(w):
				var dx: float = (float(x) + 0.5 - float(w) * 0.5) / rx
				var dy: float = (float(y) + 0.5 - cy) / ry
				var d: float = dx * dx + dy * dy
				if d > 1.0:
					continue
				# Края мягче середины: резкий контур выдаёт наклейку.
				var a: float = clampf((1.0 - d) * 2.2, 0.0, 1.0) * 0.85
				if a <= img.get_pixel(x, y).a:
					continue
				# Снег в следе не чёрный, а синеватый: это тень в ямке.
				img.set_pixel(x, y, Color(0.20, 0.24, 0.34, a))
	return ImageTexture.create_from_image(img)


## ЗАКРЫВАНИЕ УЛИЧНОЙ ДВЕРИ. Створка идёт от распахнутых 78° почти до косяка,
## быстро в начале и с придержкой в конце, а стук — в самом конце хода, а не по
## таймеру: иначе он звучит раньше, чем дверь доходит.
func _shut_door(delta: float) -> void:
	if shut_t < 0.0 or street_leaf == null:
		return
	shut_t = maxf(0.0, shut_t - delta)
	var k: float = 1.0 - shut_t / 0.85
	if k < 0.25:
		return
	var u: float = (k - 0.25) / 0.75
	street_leaf.rotation.y = lerpf(street_hinge, deg_to_rad(3.0), u * u * (3.0 - 2.0 * u))
	if not shut_said and u > 0.93:
		shut_said = true
		if sfx != null:
			sfx.play("hit_low", -4.0)
			sfx.play("scrape", -14.0)
	if shut_t <= 0.0:
		shut_t = -1.0


func _hole_dist() -> float:
	return Vector2(player.global_position.x - hole.position.x,
		player.global_position.z - hole.position.z).length()


func _process(delta: float) -> void:
	_t += delta
	# ВХОД. Управление отдаём на первом же кадре, см. ниже.
	if stage == 0:
		# НА УЛИЦЕ УПРАВЛЕНИЕ ОТДАЁМ СРАЗУ. Подход к дому — не катсцена: идти
		# тринадцать метров вместо игрока незачем, а разглядывать по дороге
		# есть что. Раньше здесь была секунда «входа», когда игрока втягивало
		# в коридор от порога; теперь порог он переступает сам.
		stage = 1
		player.set_physics_process(true)
		# Строчка на улице: она говорит, куда идти, — не стрелкой, а тем, что он
		# сам думает. Гаснет, как только он переступает порог.
		hud.text = Lang.t("p_home")
	if not been_in and player.global_position.z < street_door_z - 0.6:
		been_in = true
		hud.text = ""
		# ДВЕРЬ ЗАХЛОПЫВАЕТСЯ ЗА СПИНОЙ. Не сразу: четверть секунды — чтобы
		# успеть сделать шаг и услышать это уже позади себя.
		shut_t = 0.85
		if street_stop != null:
			street_stop.disabled = false
	_shut_door(delta)
	_try_leave(delta)
	_greet_room()
	if stage == 2:
		read_t -= delta
		if not hum_on:
			hum_on = true
			sfx.hum_start()
		# Пока «читает», комната начинает портиться: свет садится, а из-под пола
		# слышно. Ничего не объясняем — просто становится хуже.
		# 1.5, а не 0.9: чтение длится 2.4 с, и за него лампа должна сесть в ноль.
		# При 0.9 она гасла с прежних 2.6 почти дочиста, а с новых 3.6 не успевала
		# — комната к провалу оставалась освещённой, и «свет уходит» пропадало.
		lamp.light_energy = maxf(0.0, lamp.light_energy - delta * 1.5)
		# Пока он смотрит в блокнот, комната садится: свет уходит, а снизу
		# поднимается гул. Ничего не объясняем — просто становится хуже.
		var k2: float = 1.0 - clampf(read_t / 2.4, 0.0, 1.0)
		sfx.amb_level(0.12 + k2 * 0.5)
		sfx.hum_level(k2 * 0.55)
		# И ШКАТУЛКА ЗАМОЛКАЕТ. Пока он читает, комната садится: свет уходит,
		# гул поднимается, а мелодия кончается — будто завод вышел.
		sfx.box_level(0.55 * (1.0 - k2))
		if read_t <= 0.0:
			stage = 3
			sfx.box_level(0.0)
			hole.visible = true
			floor_whole.visible = false
			floor_cut.visible = true
			# Взводим сразу, если он стоит не над проломом. Ждать, пока он
			# отойдёт на полтора метра, было лишним: после блокнота он у
			# кровати, до дыры чуть меньше метра — и шаг вниз не срабатывал.
			hole_armed = _hole_dist() > 0.8
			sfx.hit(6.0)
			sfx.play("scrape", 2.0)
			hud.text = Lang.t("p_hole")
		return
	# ПРЫГАЕТ САМ. Пол не забирает его — он подходит и шагает вниз. Лианы весь
	# пролог показывали куда, и это единственное, что он тут решает сам.
	if stage == 3:
		var d: float = _hole_dist()
		# Если пол провалился прямо под ним, ждём, пока он выйдет: иначе
		# «прыжок» — не его решение, а случайность.
		if d > 0.8:
			hole_armed = true
		if hole_armed and d < 0.7:
			stage = 4
			fall_t = 2.6
			# ЛАБИРИНТ ГРУЗИТСЯ, ПОКА ОН ПАДАЕТ.
			#
			# Смена сцены стоила секунду: семьсот миллисекунд на чтение самой
			# сцены с её моделями и шейдерами и ещё шестьсот на сборку мира.
			# Всё это приходилось на застывший чёрный экран сразу после
			# падения — «какие-то задержки начались».
			#
			# Чтение уходит в фон и успевает пройти за два с половиной секунды
			# полёта; на главном потоке остаётся только сборка. Если не успело
			# — ниже есть запасной путь, обычная смена сцены.
			ResourceLoader.load_threaded_request("res://world.tscn")
			sfx.play("breath", -2.0)
			sfx.hum_level(1.0)
			hud.text = Lang.t("p_fall")
			player.set_physics_process(false)
		return
	if stage == 4:
		fall_t -= delta
		var k: float = 1.0 - clampf(fall_t / 2.6, 0.0, 1.0)
		# ПАДЕНИЕ ДОЛЖНО БЫТЬ ВИДНО. Было семь метров, и экран начинал гаснуть
		# почти сразу (на k = 0.18): большую часть провала игрок смотрел в
		# черноту, то есть падения не видел вовсе. Теперь падаем ВНУТРИ шахты —
		# восемнадцать метров, и её стенки проносятся мимо, — а темнота
		# приходит только во второй половине.
		player.global_position.y = PlayerScript.STAND_Y - 18.0 * k * k
		player.head.rotation.z = k * 0.8
		dark.color.a = clampf(k * 2.2 - 1.1, 0.0, 1.0)
		if fall_t <= 0.0:
			done = true
			var st: int = ResourceLoader.load_threaded_get_status("res://world.tscn")
			if st == ResourceLoader.THREAD_LOAD_LOADED:
				var packed = ResourceLoader.load_threaded_get("res://world.tscn")
				if packed != null:
					get_tree().change_scene_to_packed(packed)
					return
			get_tree().change_scene_to_file("res://world.tscn")


## Снять пролом: открыть, встать перед ним и отдать три кадра подряд.
func _street_probe() -> void:
	await get_tree().process_frame
	player.set_physics_process(false)
	var кадры := [
		[Vector3(-13.0, PlayerScript.STAND_Y, street_door_z + 1.8), -PI * 0.5, -2.0],
		[Vector3(-6.0, PlayerScript.STAND_Y, street_door_z + 2.6), -PI * 0.5, 2.0],
		[Vector3(-9.0, PlayerScript.STAND_Y, street_door_z + 3.0), -PI * 0.75, 4.0],
	]
	for i in кадры.size():
		player.global_position = кадры[i][0]
		player.yaw = float(кадры[i][1])
		player.rotation.y = player.yaw
		player.pitch = deg_to_rad(float(кадры[i][2]))
		player.head.rotation.x = player.pitch
		for _k in 8:
			await get_tree().process_frame
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://улица_%d.png" % i)
	print("[улица] снято ", кадры.size(), " кадра")
	get_tree().quit()


func _hole_probe() -> void:
	await get_tree().process_frame
	stage = 3
	hole.visible = true
	floor_whole.visible = false
	floor_cut.visible = true
	hole_armed = false
	lamp.light_energy = 2.4
	# Встаём на краю и смотрим в дыру: ровно та точка, с которой её и видят.
	player.global_position = Vector3(0.0, PlayerScript.STAND_Y, 0.4 - 1.5)
	player.set_physics_process(false)
	# Позу прикладываем РУКАМИ. yaw и pitch переносит в тело _view, а он живёт
	# в обычном такте под условием «физика включена» — с выключенной физикой
	# камера так и осталась смотреть на кровать.
	# Пролом лежит по +Z от игрока, значит разворот на пол-оборота: с yaw = 0
	# камера смотрела ровно в противоположную стену.
	player.yaw = PI
	player.pitch = deg_to_rad(-40.0)
	player.rotation.y = player.yaw
	player.head.rotation.x = player.pitch
	# МЕРЦАНИЕ МЕРИМ, А НЕ УГАДЫВАЕМ. Играющий: «края дыры всё ещё дрожат».
	# Дрожь видна только в движении, поэтому сдвигаем камеру на сантиметр между
	# кадрами и считаем, какая доля пикселей изменилась сильно. Совпадающие
	# поверхности дают крапчатую разницу по всему краю; честное изменение
	# картинки от сдвига — ровное и мелкое.
	var prev: Image = null
	for i in 4:
		# Первые два кадра — камера СТОИТ: это опора. Дальше сдвигаем на сантиметр.
		if i >= 2:
			player.global_position.z += 0.01
		for _k in 6:
			await get_tree().process_frame
		await RenderingServer.frame_post_draw
		var img: Image = get_viewport().get_texture().get_image()
		img.save_png("user://дыра_%d.png" % i)
		if prev != null:
			var менялось: int = 0
			var всего: int = 0
			for y in range(int(img.get_height() * 0.45), int(img.get_height() * 0.95), 4):
				for x in range(0, img.get_width(), 4):
					var a1: Color = prev.get_pixel(x, y)
					var b1: Color = img.get_pixel(x, y)
					var d1: float = absf(a1.r - b1.r) + absf(a1.g - b1.g) + absf(a1.b - b1.b)
					if d1 > 0.10:
						менялось += 1
					всего += 1
			print("[дыра] кадр %d (%s): сильно изменилось %d%% точек низа кадра"
				% [i, "камера стоит" if i < 2 else "сдвиг 1 см", 100 * менялось / maxi(всего, 1)])
		prev = img
	print("[дыра] снято 4 кадра")
	get_tree().quit()
