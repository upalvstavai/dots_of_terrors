shader_type spatial;
render_mode cull_back, diffuse_burley;
// cull_back, а не cull_disabled: при выключенном отсечении была видна ИЗНАНКА
// трубки, и кончики выглядели светлыми срезами пластика.
// Щупальце из стены. Геометрия — простой конус; вся жизнь в вершинах.
//
// Два колебания с разными частотами и по разным осям: с одним щупальце
// качается как маятник, с двумя — вьётся. Амплитуда растёт к кончику по
// квадрату, поэтому основание сидит в стене прочно, а конец мотает.

uniform float phase = 0.0;                          // своё у каждого
uniform float wave : hint_range(0.0, 1.0) = 0.28;   // размах у кончика
uniform float speed = 2.0;
// СУЖЕНИЕ ВНУТРИ МЕША. Для одиночного щупальца это правильно — конус к кончику.
// Но рука осьминога собрана из ЦЕПОЧКИ звеньев, и там каждое звено сужалось
// само в себе: получалась не рука, а нанизанные бусины с перехватами. Для
// цепочек ставим 0 и берём конус из радиусов самих цилиндров.
uniform float pinch : hint_range(0.0, 1.0) = 0.55;
uniform vec3 tint : source_color = vec3(0.045, 0.05, 0.048);
uniform vec3 rim_tint : source_color = vec3(0.20, 0.44, 0.28);
// Та же близость, что и у тела: руки не должны оставаться чёрными, когда
// сам ком уже проявился.
uniform float lit : hint_range(0.0, 1.0) = 0.0;
// МОКРОТА. По умолчанию ноль — руки твари и щупальца из стен остаются
// матовыми, как и были: блик делал из них пластиковые трубки.
//
// Но в хвате всё наоборот: там щупальце в полуметре от лица, его режут, и
// оно обязано БЛЕСТЕТЬ — иначе никакой сочности, о которой была речь, не
// появится. Блик кладём пятнами по шуму, а не ровно: ровный делает пластик.
uniform float wet : hint_range(0.0, 1.0) = 0.0;
// СИЛА РЕЛЬЕФА. Девятка писалась для щупалец из стен — их видят в темноте и
// издалека, и крупное зерно им на пользу. В хвате то же зерно с полуметра
// превращает плоть в бетонную трубу, поросшую мхом.
uniform float bump_k = 9.0;
// СИЛА КРОМКИ ОТДЕЛЬНО ОТ ЯРКОСТИ ТЕЛА.
//
// Поднять видимость щупальца через lit нельзя: он умножает и АЛЬБЕДО, и тело
// выбеливается в серую трубу. А видно вещь по силуэту — значит усиливать надо
// кромку, и только её. В хвате она горит втрое, и щупальце читается очерком
// даже там, где на него не падает ни один луч.
uniform float rim_k = 1.0;
// Насколько сильнее горит кромка вдали. Ноль — прежнее поведение.
uniform float rim_far = 0.8;

void vertex() {
	float u = clamp(VERTEX.y + 0.5, 0.0, 1.0);       // 0 — у стены, 1 — кончик
	float a = sin(TIME * speed + phase + u * 3.6);
	float b = cos(TIME * speed * 0.63 + phase * 1.7 + u * 2.4);
	VERTEX.x += a * wave * u * u;
	VERTEX.z += b * wave * 0.75 * u * u;
	// Кончик тоньше основания и слегка втягивается — щупальце дышит.
	VERTEX.xz *= 1.0 - u * pinch + sin(TIME * 1.3 + phase) * 0.04;
}

// Шум по КЛЕТКАМ давал вязаную сетку: прямоугольная решётка слишком заметна на
// вытянутом цилиндре. Сглаживаем между узлами — и это уже зерно, а не трикотаж.
float h2(vec2 p) {
	return fract(sin(dot(p, vec2(12.99, 78.23))) * 43758.5453);
}

float vn2(vec2 p) {
	vec2 i = floor(p);
	vec2 f = p - i;
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(h2(i), h2(i + vec2(1.0, 0.0)), f.x),
		mix(h2(i + vec2(0.0, 1.0)), h2(i + vec2(1.0, 1.0)), f.x), f.y);
}

void fragment() {
	// Кромка светлее: без неё чёрное щупальце на чёрной стене не читается вовсе.
	// ТО ЖЕ, ЧТО У ТУШИ (см. blob.gdshader): вдали кромка уже и ярче, тело
	// глуше. Руки — половина силуэта, и без этого он читался бы наполовину.
	float far = 1.0 - lit;
	float rim = pow(1.0 - abs(dot(normalize(NORMAL), normalize(-VERTEX))),
		mix(2.2, 3.4, far));
	ALBEDO = tint * (1.0 + lit * 3.0);
	EMISSION = rim_tint * rim * (0.30 + lit * 0.8 + far * rim_far) * rim_k;
	// РЕЛЬЕФ БЕЗ БЛИКА. Поверхность была идеально ровной, и рядом с тушей, у
	// которой кожа бугрится, щупальца читались гладкими трубками. Но вернуть
	// им зеркальность нельзя — см. ниже, — поэтому бугры даём только нормали:
	// на рассеянном свету они видны, а белого пятна дать не могут.
	float bump = vn2(UV * vec2(13.0, 47.0)) * 0.58 + vn2(UV * vec2(31.0, 110.0)) * 0.42;
	NORMAL = normalize(NORMAL + vec3(dFdx(bump), -dFdy(bump), 0.0) * bump_k);
	// Блик обязан быть нулевым. Свет палочки бьёт в упор, и при обычной
	// зеркальности концы щупалец выходили белыми — пластиковая трубка, а не
	// мокрая чёрная плоть.
	// КРУПНЫМИ ПЯТНАМИ, А НЕ КРУПОЙ. На частоте 7×19 блик рассыпался в блёстки
	// и щупальце читалось обсыпанным снегом. Мокрое блестит ПЯТНАМИ.
	float slick = vn2(UV * vec2(2.2, 5.0) + vec2(0.0, TIME * 0.04));
	slick = smoothstep(0.42, 0.92, slick);
	ROUGHNESS = mix(1.0, mix(0.55, 0.12, slick), wet);
	SPECULAR = 0.45 * wet;
	METALLIC = 0.0;
	// Слизь чуть светится сама: в темноте иначе блеснуть нечем — света вокруг
	// почти нет, а мокрым оно должно выглядеть всё равно.
	EMISSION += vec3(0.10, 0.26, 0.16) * wet * slick * 0.28;
}
